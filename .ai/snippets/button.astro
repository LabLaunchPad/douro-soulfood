---
// Snippet: minimal Astro button component, matching this repo's real
// src/components/ui/Button.astro conventions. Copy and adapt, don't
// import this file directly.
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
} = Astro.props;

const variants = {
  primary: 'bg-brand-gold text-brand-espresso hover:bg-brand-gold-light',
  secondary: 'border border-border-default text-text-secondary hover:bg-surface-elevated',
  ghost: 'text-text-secondary hover:text-text-primary hover:bg-surface-elevated',
};
const sizes = {
  sm: 'min-h-9 px-3 py-2 text-sm',
  md: 'min-h-11 px-5 py-2.5 text-sm',
  lg: 'min-h-12 px-6 py-3 text-base',
};

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  class:list={[
    'inline-flex items-center justify-center font-semibold rounded-[var(--radius-sm)]',
    'transition-all duration-[var(--duration-fast)] ease-[var(--ease-spring)]',
    'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-brand-gold)]',
    variants[variant],
    sizes[size],
    className,
  ]}
>
  <slot />
</Tag>
