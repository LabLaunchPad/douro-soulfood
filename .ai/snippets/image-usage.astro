---
// Snippet: correct Astro <Image> usage for this repo's public/images/
// convention. width/height MUST be the source file's real pixel
// dimensions (check via `file` or PIL) — never guessed, never copied
// from an unrelated image. Guessing caused a real bug once (hardcoded
// width="600" height="450" that matched none of the actual files).
import { Image } from 'astro:assets';

interface ImageItem {
  src: string;
  alt: string;
  width: number; // real source file width in px
  height: number; // real source file height in px
}

