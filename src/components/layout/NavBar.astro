---
/**
 * NavBar — Floating pill over hero, solid bar on scroll + Mobile Capsule Trigger
 *
 * - At top: transparent shell, logo free-floating left, white pill capsule
 *   with dark links right (owner direction, Talkin-style pattern).
 * - Scrolled: solid warm-white bar (bg-surface-primary), pill dissolves.
 * - The logo is a logotype (exempt from text-contrast rules) and stays untouched.
 * - Mobile capsule navbar containing German "Speisekarte" button + hamburger icon,
 *   which toggles the full-screen drawer rendered by MobileNavDrawer.astro.
 */

import { Image } from 'astro:assets';
import MobileNavDrawer from './MobileNavDrawer.astro';
import { NAV_LINKS, type NavLink } from '@/lib/nav';
import { orderUrl } from '@/lib/site';
import brandLogo from '@/assets/brand/dourologo.webp';
import { t } from '@/lib/i18n/ui';

interface Props {
  links?: NavLink[];
  ctaPrimary?: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  class?: string;
}

const {
  links = NAV_LINKS,
  ctaPrimary = { label: 'Jetzt bestellen', href: orderUrl },
  ctaSecondary = { label: 'Reservierung', href: '/contact' },
  class: className = '',
} = Astro.props;
---

<nav
  aria-label="Hauptmenü"
  class:list={[
    'nav-shell fixed top-0 inset-x-0 z-50 transition-all duration-300 ease-out',
    className,
  ]}
  data-nav
  data-scrolled="false"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 md:px-12 py-3 md:py-4">
    <!-- Left: Logo Image Only -->
    <div class="shrink-0">
      <a
        href="/"
        class="flex items-center no-underline hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold-ink rounded-xs"
        aria-label="D'ouro Soulfood Homepage"
      >
        <Image
          src={brandLogo}
          alt="D'ouro Soulfood Bistro Logo"
          width={292}
          height={139}
          class="h-10 md:h-12 w-auto object-contain transition-transform duration-300 hover:scale-105"
        />
      </a>
    </div>

    <!-- Right: Desktop floating pill (white capsule over hero; dissolves into the bar on scroll) -->
    <div class="hidden lg:flex items-center">
      <div class="nav-pill flex items-center gap-3 rounded-full px-3 py-1.5 bg-white/95 backdrop-blur-md border border-black/5 shadow-xl transition-all duration-300 ease-out">
        <!-- Nav links -->
        <div class="flex items-center gap-1">
          {links.map((link) => (
            <a
              href={link.href}
              class="px-3.5 py-2 text-sm font-bold tracking-wider uppercase text-text-primary hover:text-brand-gold-ink
                     no-underline transition-colors duration-200 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold-ink"
            >
              {link.label}
            </a>
          ))}
        </div>

        <!-- Secondary Button (Reservierung — SSOT: rounded-sm = 10px) -->
        {ctaSecondary && (
          <a
            href={ctaSecondary.href}
            class="px-4 py-2 text-sm font-bold tracking-wider uppercase text-text-primary rounded-sm border border-text-primary/25
                   hover:bg-text-primary/5 hover:border-text-primary/50 no-underline transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold-ink"
          >
            {ctaSecondary.label}
          </a>
        )}

        <!-- Primary CTA (D'ouro Brand Gold — SSOT: rounded-sm = 10px) -->
        {ctaPrimary && (
          <a
            href={ctaPrimary.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-1.5 px-5 py-2 text-sm font-extrabold tracking-wider uppercase rounded-sm
                   bg-brand-gold hover:bg-brand-gold-light active:bg-brand-gold-dark text-brand-espresso
                   no-underline transition-all duration-200 shadow-md hover:shadow-lg hover:scale-[1.02]"
          >
            <span>{ctaPrimary.label}</span>
            <svg
              class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </a>
        )}
      </div>
    </div>

    <!-- Mobile Navigation Capsule (SSOT: rounded-md container, rounded-sm button) -->
    <div class="flex lg:hidden items-center">
      <div class="flex items-center gap-2 bg-surface-card border border-border-subtle rounded-md px-2.5 py-1.5 shadow-md">
        <!-- German "Speisekarte" Link Button (SSOT: rounded-sm = 10px) -->
        <a
          href="/menu"
          class="flex min-h-12 items-center px-3 py-1 text-xs font-extrabold tracking-wide text-text-primary border border-text-primary/25 rounded-sm
                 hover:bg-text-primary/5 no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold-ink"
        >
          Speisekarte
        </a>

        <!-- Hamburger Icon Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="flex justify-center items-center w-11 h-11 rounded-sm text-text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold-ink"
          aria-label={t('nav.drawer.open')}
          data-label-open={t('nav.drawer.open')}
          data-label-close={t('nav.drawer.close')}
          aria-expanded="false"
        >
          <div class="flex flex-col gap-1.5 justify-center items-center w-5 h-5">
            <span
              class="block h-0.5 w-5 bg-text-primary rounded-full transition-all duration-200"
              data-line-top
            ></span>
            <span
              class="block h-0.5 w-5 bg-text-primary rounded-full transition-all duration-200"
              data-line-mid
            ></span>
            <span
              class="block h-0.5 w-5 bg-text-primary rounded-full transition-all duration-200"
              data-line-bot
            ></span>
          </div>
        </button>
      </div>
    </div>
  </div>
</nav>

<MobileNavDrawer links={links} />

<slot />

<style>
  /* Floating-pill pattern (owner direction, Talkin-style): transparent shell +
     white capsule at top; solid bar with dissolved capsule once scrolled. */
  .nav-shell {
    background: transparent;
  }
  .nav-shell[data-scrolled='true'] {
    background: color-mix(in srgb, var(--color-surface-primary) 95%, transparent);
    border-bottom: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-md);
    backdrop-filter: blur(12px);
  }
  .nav-shell[data-scrolled='true'] .nav-pill {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }
</style>

<script>
  // Pill-to-bar scroll state: floating white capsule over the hero at top,
  // full solid bar once the visitor scrolls. Drawer logic lives in MobileNavDrawer.astro.
  const shell = document.querySelector('[data-nav]') as HTMLElement | null;
  if (shell) {
    const sync = () => {
      shell.dataset.scrolled = String(window.scrollY > 20);
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>
