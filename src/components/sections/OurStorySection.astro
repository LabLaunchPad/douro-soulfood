---
/**
 * OurStorySection — founder-story block ("Wie D'ouro begann" on the home page).
 *
 * Not the same as the old `OurStory.astro` removed in an earlier cleanup
 * pass (that one was dead: zero importers). This one is authored fresh and
 * is actually wired into index.astro.
 */
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  founderName: string;
  founderTitle: string;
  ariaLabel: string;
}

const { eyebrow, title, text, founderName, founderTitle, ariaLabel } = Astro.props;
---

<section class="w-full py-section-mobile md:py-20 bg-brand-espresso" aria-label={ariaLabel}>
  <div class="max-w-3xl mx-auto px-4 md:px-16">
    <span class="inline-block text-xs md:text-sm font-semibold text-brand-gold uppercase tracking-wider mb-1">
      {eyebrow}
    </span>
    <h2 class="text-2xl md:text-3xl font-semibold text-white font-display mb-3">{title}</h2>
    <p class="text-base text-white/90 leading-relaxed max-w-[52ch]">{text}</p>
    <div class="mt-6 flex items-center gap-3">
      <div
        class="w-10 h-10 rounded-full bg-brand-gold/20 flex items-center justify-center"
        aria-hidden="true"
      >
        <svg
          class="w-5 h-5 text-brand-gold"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
      </div>
      <div class="text-left">
        <p class="text-xs md:text-sm font-semibold text-white">{founderName}</p>
        <p class="text-xs text-white/70">{founderTitle}</p>
      </div>
    </div>
  </div>
</section>
