---
/**
 * FaqAccordion — plain <details>-based accordion for the home page's FAQ
 * section. Renders nothing if `items` is empty (matches the previous
 * inline `{faqItems.length > 0 && (...)}` guard in index.astro).
 */
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  ariaLabel: string;
  eyebrow: string;
  title: string;
}

const { items, ariaLabel, eyebrow, title } = Astro.props;
---

{items.length > 0 && (
  <section class="py-section-mobile md:py-5 px-4 md:px-16 max-w-7xl mx-auto" aria-label={ariaLabel}>
    <div class="text-center mb-4 md:mb-5">
      <span class="inline-block text-xs md:text-sm font-semibold text-brand-gold-ink uppercase tracking-wider mb-1">
        {eyebrow}
      </span>
      <h2 class="text-xl md:text-3xl font-semibold text-text-primary font-display">
        {title}
      </h2>
    </div>
    <div class="flex flex-col max-w-4xl mx-auto">
      {items.map((item) => (
        <details class="w-full border-b border-border-subtle group">
          <summary
            class="flex min-h-11 items-center justify-between py-4 cursor-pointer list-none
                   text-text-primary font-medium text-sm md:text-base
                   focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold rounded-sm
                   transition-colors duration-[var(--duration-fast)] ease-[var(--ease-spring)] hover:text-brand-gold-ink"
          >
            <span>{item.question}</span>
            <svg
              class="w-4 h-4 md:w-5 md:h-5 text-text-tertiary transition-transform duration-[var(--duration-fast)] ease-[var(--ease-out-quint)] group-open:rotate-180 shrink-0 ml-4"
              viewBox="0 0 20 20" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 7.5L10 12.5L15 7.5" />
            </svg>
          </summary>
          <div class="pb-4 text-text-secondary leading-relaxed text-xs md:text-sm">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </section>
)}
