---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '@/components/ui/Button.astro';

/**
 * PhotoGrid — heading + responsive photo grid (2 cols mobile, 3 cols desktop).
 *
 * Shows 8 photos on mobile, 9 on desktop (the 9th item is hidden below the
 * `sm` breakpoint) — used for the home page's "Beliebte Gerichte" and
 * "Galerie" sections, which previously duplicated this exact markup.
 *
 * Tiles are portrait 3:4 (Talkin'-Tacos-style food verticals): square dish
 * sources center-crop via object-cover, which suits close-up food shots;
 * 6 of 9 Galerie sources are already native 3:4 portrait.
 */
interface PhotoItem {
  src: ImageMetadata;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  ariaLabel: string;
  eyebrow: string;
  title: string;
  description?: string;
  items: PhotoItem[];
  cta?: { label: string; href: string };
  /**
   * Commerce header (Talkin'-Tacos `Featured` pattern): left-aligned title
   * with the CTA docked header-right instead of a centered button block
   * below the grid. One CTA per section, trained eye toward the menu.
   */
  variant?: 'center' | 'commerce';
  /**
   * When set, every tile gets a persistent order button (gold circle,
   * bottom-right) linking out — the honest version of the `+` quick-add
   * overlay. Persistent, never hover-only, so touch and keyboard get it too.
   */
  orderHref?: string;
}

const { ariaLabel, eyebrow, title, description, items, cta, variant = 'center', orderHref } = Astro.props;
const commerce = variant === 'commerce';
---

<section class="py-section-mobile md:py-20" aria-label={ariaLabel}>
  <div class="max-w-7xl mx-auto px-4 md:px-16">
  <div
    class:list={[
      'mb-4 md:mb-5',
      commerce ? 'flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between' : 'text-center',
    ]}
  >
    <div class={commerce ? 'text-left' : undefined}>
      <span class="inline-block text-xs md:text-sm font-semibold text-brand-gold-ink uppercase tracking-wider mb-1">
        {eyebrow}
      </span>
      <h2 class="text-2xl md:text-3xl font-semibold text-text-primary font-display">{title}</h2>
      {description && (
        <p class:list={['text-text-secondary mt-1 max-w-[52ch] text-xs md:text-sm', !commerce && 'mx-auto']}>{description}</p>
      )}
    </div>
    {commerce && cta && (
      <Button href={cta.href} variant="secondary" size="sm" arrow class="shrink-0 self-start sm:self-auto">
        {cta.label}
      </Button>
    )}
  </div>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-3 gap-2 md:gap-4 px-2 md:px-4">
    {items.map((item, index) => (
      <div
        class:list={[
          'group relative aspect-[3/4] rounded-lg overflow-hidden bg-surface-card shadow-md transition-all duration-[var(--duration-normal)]',
          index === 8 && 'hidden sm:block',
        ]}
      >
        <Image
          src={item.src}
          alt={item.alt}
          width={item.width}
          height={item.height}
          format="webp"
          quality={85}
          class="w-full h-full object-cover transition-transform duration-[var(--duration-normal)] ease-[var(--ease-out-quart)] group-hover:scale-105"
          loading="lazy"
        />
        {orderHref && (
          <a
            href={orderHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${item.alt} auf Lieferando bestellen`}
            class="absolute bottom-2 right-2 inline-flex min-h-11 min-w-11 items-center justify-center rounded-full
                   bg-brand-gold text-brand-espresso shadow-md
                   transition-transform duration-[var(--duration-fast)] ease-[var(--ease-spring)]
                   hover:scale-105 active:scale-95
                   focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 256 256"
              fill="none"
              stroke="currentColor"
              stroke-width="24"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="70" y1="128" x2="216" y2="128" />
              <polyline points="144 56 216 128 144 200" />
            </svg>
          </a>
        )}
      </div>
    ))}
  </div>

  {!commerce && cta && (
    <div class="mt-4 md:mt-6 text-center max-w-7xl mx-auto px-4 md:px-16">
      <Button href={cta.href} variant="primary" size="lg" arrow class="shadow-glow-gold">
        {cta.label}
      </Button>
    </div>
  )}
</section>
