---
import { Image } from 'astro:assets';

/**
 * PhotoGrid — heading + responsive photo grid (2 cols mobile, 3 cols desktop).
 *
 * Shows 8 photos on mobile, 9 on desktop (the 9th item is hidden below the
 * `sm` breakpoint) — used for the home page's "Beliebte Gerichte" and
 * "Galerie" sections, which previously duplicated this exact markup.
 */
interface PhotoItem {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  ariaLabel: string;
  eyebrow: string;
  title: string;
  description?: string;
  items: PhotoItem[];
  cta?: { label: string; href: string };
}

const { ariaLabel, eyebrow, title, description, items, cta } = Astro.props;
---

<section class="py-section-mobile md:py-5 px-4 md:px-16 max-w-7xl mx-auto" aria-label={ariaLabel}>
  <div class="text-center mb-4 md:mb-5">
    <span class="inline-block text-xs md:text-sm font-semibold text-brand-gold-ink uppercase tracking-wider mb-1">
      {eyebrow}
    </span>
    <h2 class="text-xl md:text-3xl font-semibold text-text-primary font-display">
      {title}
    </h2>
    {description && (
      <p class="text-text-secondary mt-1 max-w-[52ch] mx-auto text-xs md:text-sm">
        {description}
      </p>
    )}
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-4 md:gap-6">
    {items.map((item, index) => (
      <div class:list={[
        'group relative aspect-square sm:aspect-[4/3] rounded-2xl overflow-hidden bg-surface-card border border-border-subtle hover:border-brand-gold/50 shadow-md transition-all duration-[var(--duration-normal)]',
        index === 8 && 'hidden sm:block',
      ]}>
        <Image
          src={item.src}
          alt={item.alt}
          width={item.width}
          height={item.height}
          format="webp"
          quality={85}
          class="w-full h-full object-cover transition-transform duration-[var(--duration-normal)] ease-[var(--ease-out-quart)] group-hover:scale-105"
          loading="lazy"
        />
      </div>
    ))}
  </div>

  {cta && (
    <div class="mt-4 md:mt-6 text-center">
      <a
        href={cta.href}
        class="group inline-flex items-center gap-2 rounded-sm
               bg-brand-gold hover:bg-brand-gold-light active:bg-brand-gold-dark
               min-h-10 md:min-h-12 px-5 py-2.5 md:py-3 text-sm md:text-base font-semibold text-brand-espresso
               focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold
               no-underline transition-colors duration-[var(--duration-fast)] ease-[var(--ease-spring)] shadow-glow-gold"
      >
        {cta.label}
        <svg
          class="w-4 h-4 opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-[var(--duration-fast)] ease-[var(--ease-spring)]"
          viewBox="0 0 256 256"
          fill="none"
          stroke="currentColor"
          stroke-width="24"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="70" y1="128" x2="216" y2="128" />
          <polyline points="144 56 216 128 144 200" />
        </svg>
      </a>
    </div>
  )}
</section>
