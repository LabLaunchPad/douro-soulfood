---
import { Image } from 'astro:assets';

/**
 * PhotoScroll — heading + auto-scrolling, drag/swipe-able photo strip(s).
 *
 * Story-style horizontal rows: content is duplicated per row for a seamless
 * loop, auto-advances via rAF, and pauses on user touch/drag/hover (resuming
 * a couple seconds after release). Each row is a native scroll container
 * (not a CSS transform), so mouse-drag and touch-swipe work for free.
 * Rows split from a single `items` list round-robin so a natural drag
 * anywhere lands on a real photo in every row.
 */
interface PhotoItem {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  ariaLabel: string;
  eyebrow: string;
  title: string;
  description?: string;
  items: PhotoItem[];
  rows?: number;
  cta?: { label: string; href: string };
}

const { ariaLabel, eyebrow, title, description, items, rows = 1, cta } = Astro.props;

const rowItems: PhotoItem[][] = Array.from({ length: rows }, (_, r) =>
  items.filter((_, i) => i % rows === r)
);

// Width drives card size (so a fixed number of cards + a peek of the next
// one show per tier); height follows from the aspect ratio. Multi-row grids
// use narrower cards so N stacked rows still fit one viewport's height budget.
const cardWidthClass =
  rows === 1
    ? 'w-[58vw] sm:w-[34vw] lg:w-[24vw] xl:w-[19vw]'
    : rows === 2
      ? 'w-[42vw] sm:w-[26vw] lg:w-[18vw] xl:w-[14vw]'
      : 'w-[32vw] sm:w-[20vw] lg:w-[14vw] xl:w-[11vw]';
---

<section class="photo-scroll flex flex-col min-h-screen justify-center py-6 md:py-8 px-4 md:px-16" aria-label={ariaLabel}>
  <div class="max-w-7xl w-full mx-auto text-center mb-3 md:mb-5 shrink-0">
    <span class="inline-block text-xs md:text-sm font-semibold text-brand-gold-ink uppercase tracking-wider mb-1">
      {eyebrow}
    </span>
    <h2 class="text-xl md:text-3xl font-semibold text-text-primary font-display">
      {title}
    </h2>
    {description && (
      <p class="text-text-secondary mt-1 max-w-[52ch] mx-auto text-xs md:text-sm">
        {description}
      </p>
    )}
  </div>

  <div class="flex flex-col gap-2.5 sm:gap-4">
    {rowItems.map((row) => {
      const track = [...row, ...row];
      return (
        <div class="photo-scroll-row w-full overflow-x-auto marquee-mask" data-scroll-row>
          <div class="flex gap-2.5 sm:gap-4 w-max px-4 md:px-16" data-scroll-track>
            {track.map((item) => (
              <div class:list={['group relative shrink-0 aspect-[3/4] lg:aspect-[4/5] rounded-2xl overflow-hidden bg-surface-card border border-border-subtle hover:border-brand-gold/50 shadow-md transition-all duration-[var(--duration-normal)]', cardWidthClass]}>
                <Image
                  src={item.src}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  format="webp"
                  quality={85}
                  class="w-full h-full object-cover transition-transform duration-[var(--duration-normal)] ease-[var(--ease-out-quart)] group-hover:scale-105"
                  loading="lazy"
                  draggable="false"
                />
              </div>
            ))}
          </div>
        </div>
      );
    })}
  </div>

  {cta && (
    <div class="mt-4 md:mt-6 text-center shrink-0">
      <a
        href={cta.href}
        class="group inline-flex items-center gap-2 rounded-sm
               bg-brand-gold hover:bg-brand-gold-light active:bg-brand-gold-dark
               min-h-10 md:min-h-12 px-5 py-2.5 md:py-3 text-sm md:text-base font-semibold text-brand-espresso
               focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold
               no-underline transition-colors duration-[var(--duration-fast)] ease-[var(--ease-spring)] shadow-glow-gold"
      >
        {cta.label}
        <svg
          class="w-4 h-4 opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-[var(--duration-fast)] ease-[var(--ease-spring)]"
          viewBox="0 0 256 256"
          fill="none"
          stroke="currentColor"
          stroke-width="24"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="70" y1="128" x2="216" y2="128" />
          <polyline points="144 56 216 128 144 200" />
        </svg>
      </a>
    </div>
  )}
</section>

<style>
  .photo-scroll-row {
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  .photo-scroll-row::-webkit-scrollbar {
    display: none;
  }

  .photo-scroll-row:active {
    cursor: grabbing;
  }

  .photo-scroll-row[data-dragging='true'] {
    scroll-snap-type: none;
  }
</style>

<script>
  // Auto-scrolling, drag/swipe-able photo rows.
  // Each row's track is the item list duplicated once, so once scrollLeft
  // passes the halfway point we can subtract that half back off for a
  // seamless infinite loop in either direction.
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-scroll-row]').forEach((row) => {
    const track = row.querySelector<HTMLElement>('[data-scroll-track]');
    if (!track) return;

    let paused = false;
    let resumeTimer: ReturnType<typeof setTimeout> | null = null;
    let isPointerDown = false;
    let dragStartX = 0;
    let dragStartScroll = 0;
    let dragged = false;

    // scrollLeft only accepts whole pixels, so sub-pixel-per-frame speeds
    // (needed for a slow, smooth crawl) get truncated back to the same
    // integer every frame and never accumulate. Track position as a float
    // ourselves and round only when writing it to the DOM.
    let virtualLeft = 0;
    let lastTs: number | null = null;

    const halfWidth = () => track.scrollWidth / 2;

    const normalizeVirtual = () => {
      const half = halfWidth();
      if (half <= 0) return;
      virtualLeft = ((virtualLeft % half) + half) % half;
    };

    const pause = () => {
      paused = true;
      if (resumeTimer) clearTimeout(resumeTimer);
    };

    const scheduleResume = () => {
      if (resumeTimer) clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => {
        paused = false;
      }, 2000);
    };

    row.addEventListener('pointerdown', (e) => {
      isPointerDown = true;
      dragged = false;
      dragStartX = e.clientX;
      dragStartScroll = row.scrollLeft;
      row.dataset.dragging = 'true';
      pause();
    });

    row.addEventListener('pointermove', (e) => {
      if (!isPointerDown) return;
      const dx = e.clientX - dragStartX;
      if (Math.abs(dx) > 3) dragged = true;
      row.scrollLeft = dragStartScroll - dx;
    });

    const endDrag = () => {
      if (!isPointerDown) return;
      isPointerDown = false;
      row.dataset.dragging = 'false';
      // Native drag moved row.scrollLeft directly — resync our accumulator
      // so auto-scroll resumes from where the user left it, not a stale spot.
      virtualLeft = row.scrollLeft;
      lastTs = null;
      scheduleResume();
    };

    row.addEventListener('pointerup', endDrag);
    row.addEventListener('pointercancel', endDrag);
    row.addEventListener('pointerleave', () => {
      if (isPointerDown) endDrag();
    });

    row.addEventListener('mouseenter', pause);
    row.addEventListener('mouseleave', () => {
      if (!isPointerDown) scheduleResume();
    });

    row.addEventListener('click', (e) => {
      if (dragged) {
        e.preventDefault();
        e.stopPropagation();
      }
    });

    // Start each row at the loop midpoint so drag can move either direction.
    requestAnimationFrame(() => {
      virtualLeft = halfWidth() / 2;
      row.scrollLeft = Math.round(virtualLeft);
    });

    if (!prefersReducedMotion) {
      const pxPerSecond = 28;
      const step = (ts: number) => {
        if (!paused) {
          if (lastTs !== null) {
            const dt = Math.min((ts - lastTs) / 1000, 0.1);
            virtualLeft += pxPerSecond * dt;
            normalizeVirtual();
            row.scrollLeft = Math.round(virtualLeft);
          }
          lastTs = ts;
        } else {
          lastTs = null;
        }
        requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
  });
</script>
