---
/**
 * UserReviews — Premium testimonial section displaying guest reviews.
 * Displays: 5-star ratings, testimonial text, reviewer names, avatars (initials), and review source.
 * Styled using the project's glassmorphism and gold branding tokens.
 *
 * ponytail: sources stay generic ("Gast") until reviews move to Keystatic with
 * URL + date + consent. Never attribute these hardcoded quotes to Google or
 * TripAdvisor — unverifiable provenance must not wear a platform's name.
 */

interface Review {
  name: string;
  source: string;
  rating: number;
  text: string;
}

interface Props {
  /** Section title */
  title?: string;
  /** Section subtitle */
  subtitle?: string;
  /** Custom list of reviews */
  reviews?: Review[];
}

const {
  title = 'Was unsere Gäste sagen',
  subtitle = 'Echtes Feedback von unseren Gästen in Salzburg.',
  reviews = [
    {
      name: 'Lukas M.',
      source: 'Gast',
      rating: 5,
      text: 'Das beste Afro-Latin Food in Salzburg! Die Beef Tacos und die Caipirinha sind einfach weltklasse. Super Atmosphäre und Angela ist extrem herzlich.',
    },
    {
      name: 'Amara K.',
      source: 'Gast',
      rating: 5,
      text: 'Angelas Essen ist voller Geschmack und mit viel Liebe gekocht. Der Fufu und die Egusi-Suppe haben mich direkt nach Westafrika zurückversetzt. Ein absolutes Juwel in der Stadt!',
    },
    {
      name: 'Sophie B.',
      source: 'Gast',
      rating: 5,
      text: 'Wir haben das Catering für eine Firmenfeier gebucht und alle waren restlos begeistert. Unglaublich leckeres Essen, frische Zutaten und toller Service!',
    },
  ],
} = Astro.props;

// Helper to get initials for avatar
const getInitials = (name: string) => {
  return name
    .split(' ')
    .map((n) => n[0])
    .join('')
    .toUpperCase();
};

/* Doubled (not tripled): the -50% loop needs two halves; one doubled half
   (6 cards ≈ 2304px desktop / 1944px mobile) already exceeds the widest viewport. */
const marqueeReviews = [...reviews, ...reviews];
---

<section class="w-full py-section-mobile md:py-20" aria-label="Gästebewertungen" data-reviews>
  <div class="max-w-7xl mx-auto px-4 md:px-16 text-center mb-4 md:mb-5">
    <span class="inline-block text-sm font-semibold text-brand-gold-ink uppercase tracking-wider mb-1">
      Bewertungen
    </span>
    <h2 class="text-2xl md:text-4xl font-semibold text-text-primary font-display">{title}</h2>
    <p class="text-text-secondary mt-3 max-w-[52ch] mx-auto">{subtitle}</p>
    {/* WCAG 2.2.2: >5s auto-motion needs a persistent pause control —
        hover-pause alone excludes keyboard/touch users. */}
    <button
      type="button"
      data-marquee-toggle
      aria-controls="guest-reviews-track"
      aria-label="Automatisches Scrollen der Bewertungen stoppen"
      class="mt-4 inline-flex min-h-12 items-center gap-2 rounded-sm border border-border-default bg-surface-card px-4 text-xs font-semibold uppercase tracking-wider text-text-secondary no-underline transition-colors duration-[var(--duration-fast)] ease-[var(--ease-spring)] hover:border-border-emphasis hover:text-text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
    >
      <svg
        class="w-3.5 h-3.5"
        viewBox="0 0 16 16"
        fill="currentColor"
        aria-hidden="true"
      >
        <rect x="3" y="2" width="3.5" height="12" rx="1" />
        <rect x="9.5" y="2" width="3.5" height="12" rx="1" />
      </svg>
      <span data-marquee-toggle-label>Animation pausieren</span>
    </button>
  </div>

  <div id="guest-reviews-track" class="marquee-viewport w-full overflow-hidden marquee-mask py-4">
    <div class="flex w-max animate-marquee" data-marquee-track>
      {/* Track A */}
      <div class="flex gap-6 pr-6 shrink-0">
        {marqueeReviews.map((review) => (
          <div class="flex flex-col justify-between w-[300px] sm:w-[360px] shrink-0 rounded-lg bg-surface-glass backdrop-blur-sm border border-border-subtle p-6 md:p-8 transition-all duration-[var(--duration-fast)] ease-[var(--ease-spring)] hover:border-border-default hover:shadow-md">
            <div class="flex flex-col gap-4">
              {/* Star rating */}
              <div
                class="flex items-center gap-0.5 text-brand-gold"
                role="img"
                aria-label={`${review.rating} Sterne`}
              >
                {Array.from({ length: review.rating }).map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>

              {/* Testimonial text */}
              <p class="text-text-secondary italic leading-relaxed text-base">"{review.text}"</p>
            </div>

            {/* Reviewer Details */}
            <div class="flex items-center gap-3 mt-6 pt-4 border-t border-border-subtle/50">
              <div class="w-10 h-10 rounded-full bg-brand-gold/10 text-brand-gold-ink font-bold flex items-center justify-center text-sm shrink-0 border border-brand-gold/20 select-none">
                {getInitials(review.name)}
              </div>
              <div class="flex flex-col min-w-0">
                <span class="text-sm font-semibold text-text-primary truncate">{review.name}</span>
                <span class="text-xs text-text-tertiary truncate">{review.source}</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* Track B (Duplicated for seamless looping) */}
      <div class="flex gap-6 pr-6 shrink-0" aria-hidden="true" data-marquee-track-dup>
        {marqueeReviews.map((review) => (
          <div class="flex flex-col justify-between w-[300px] sm:w-[360px] shrink-0 rounded-lg bg-surface-glass backdrop-blur-sm border border-border-subtle p-6 md:p-8 transition-all duration-[var(--duration-fast)] ease-[var(--ease-spring)] hover:border-border-default hover:shadow-md">
            <div class="flex flex-col gap-4">
              {/* Star rating */}
              <div
                class="flex items-center gap-0.5 text-brand-gold"
                role="img"
                aria-label={`${review.rating} Sterne`}
              >
                {Array.from({ length: review.rating }).map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>

              {/* Testimonial text */}
              <p class="text-text-secondary italic leading-relaxed text-base">"{review.text}"</p>
            </div>

            {/* Reviewer Details */}
            <div class="flex items-center gap-3 mt-6 pt-4 border-t border-border-subtle/50">
              <div class="w-10 h-10 rounded-full bg-brand-gold/10 text-brand-gold-ink font-bold flex items-center justify-center text-sm shrink-0 border border-brand-gold/20 select-none">
                {getInitials(review.name)}
              </div>
              <div class="flex flex-col min-w-0">
                <span class="text-sm font-semibold text-text-primary truncate">{review.name}</span>
                <span class="text-xs text-text-tertiary truncate">{review.source}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Pause/Play toggle for the testimonial marquee (WCAG 2.2.2). Class toggle
  // sticks until re-activated; hover pause is pure CSS and never overrides it.
  const section = document.querySelector<HTMLElement>('[data-reviews]');
  const toggle = section?.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
  const label = toggle?.querySelector<HTMLElement>('[data-marquee-toggle-label]');

  if (section && toggle && label) {
    const LABEL_PAUSE = 'Animation pausieren';
    const LABEL_RESUME = 'Animation fortsetzen';
    const ARIA_PAUSE = 'Automatisches Scrollen der Bewertungen stoppen';
    const ARIA_RESUME = 'Automatisches Scrollen der Bewertungen fortsetzen';

    toggle.addEventListener('click', () => {
      const paused = section.classList.toggle('reviews-paused');
      label.textContent = paused ? LABEL_RESUME : LABEL_PAUSE;
      toggle.setAttribute('aria-label', paused ? ARIA_RESUME : ARIA_PAUSE);
    });
  }
</script>
