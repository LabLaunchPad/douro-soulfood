---
/**
 * Footer — Option A: Floating Silver / Platinum Grey Card Layout
 *
 * Structure:
 * - Outer container sits on light/white page surface (bg-surface-primary).
 * - Main footer content is enclosed in a floating Silver / Platinum Grey capsule card
 *   (bg-neutral-100 border border-neutral-200 rounded-2xl shadow-xl).
 * - Top row: Logo (/dourologo.png), navigation links, and D'ouro Brand Gold CTA button.
 * - Divider line & legal links inside the card.
 * - Outer bottom bar: Social icons, copyright notice, and location info.
 */

interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  brandName?: string;
  brandSubtitle?: string;
  tagline?: string;
  links?: FooterLink[];
  cta?: { label: string; href: string };
  address?: string[];
  phone?: string;
  phoneHref?: string;
  legalLinks?: FooterLink[];
  copyrightName?: string;
}

const currentYear = new Date().getFullYear();

const {
  tagline = 'Brasilianische Seele. Afro-Lateinische Aromen. Mitten in Salzburg. Mit Liebe gekocht, mit Herz serviert.',
  links = [
    { label: 'Speisekarte', href: '/menu' },
    { label: 'Catering & Events', href: '/catering' },
    { label: 'Über uns', href: '/about' },
    { label: 'Kontakt', href: '/contact' },
    { label: 'Geschenkkarten', href: '/gift-cards' },
  ],
  cta = { label: 'Jetzt bestellen', href: 'https://www.foodora.at/en/restaurant/noch/douro-soulfood-bistro' },
  address = ['Auerspergstraße 10, 5020 Salzburg'],
  phone = '+43 676 4231921',
  phoneHref = 'tel:+436764231921',
  legalLinks = [
    { label: 'Impressum', href: '/impressum' },
    { label: 'Datenschutz', href: '/datenschutz' },
  ],
  copyrightName = "D'ouro Soulfood Bistro",
} = Astro.props;
---

<footer class="bg-surface-primary pt-8 pb-16 md:pb-12 border-t border-border-subtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Main Floating Medium Silver Metallic Capsule Card -->
    <div class="bg-zinc-300/90 border border-zinc-300/90 backdrop-blur-md rounded-2xl p-6 sm:p-8 md:p-10 shadow-xl transition-all duration-300">

      <!-- Top Row: Logo, Nav Links, Order CTA -->
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 lg:gap-12">

        <!-- Left: Logo & Tagline -->
        <div class="flex flex-col gap-3 max-w-sm shrink-0">
          <a
            href="/"
            class="inline-block no-underline hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold rounded-xs"
            aria-label="D'ouro Soulfood Homepage"
          >
            <img
              src="/dourologo.png"
              alt="D'ouro Soulfood Logo"
              class="h-10 md:h-12 w-auto object-contain transition-transform duration-200 hover:scale-105"
            />
          </a>
          <p class="text-xs md:text-sm text-zinc-700 leading-relaxed font-sans font-medium">
            {tagline}
          </p>
        </div>

        <!-- Middle: Navigation Links -->
        <nav
          class="flex flex-wrap items-center gap-x-6 gap-y-3"
          aria-label="Footer Navigation"
        >
          {links.map((link) => (
            <a
              href={link.href}
              class="text-sm md:text-base font-bold text-zinc-900 hover:text-brand-gold
                     no-underline transition-colors duration-200 rounded-sm"
            >
              {link.label}
            </a>
          ))}
        </nav>

        <!-- Right: Primary Order CTA Button (D'ouro Brand Gold) -->
        <div class="shrink-0">
          <a
            href={cta.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 px-6 py-3 text-sm md:text-base font-extrabold tracking-wider uppercase rounded-sm
                   bg-brand-gold hover:bg-brand-gold-light active:bg-brand-gold-dark text-brand-espresso
                   no-underline transition-all duration-200 shadow-md hover:shadow-lg hover:scale-[1.02]"
          >
            <span>{cta.label}</span>
            <svg
              class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Horizontal Divider Line -->
      <div class="border-t border-zinc-300 my-6 md:my-8"></div>

      <!-- Inner Bottom Row: Legal Links -->
      <div class="flex flex-wrap items-center gap-6">
        {legalLinks.map((link) => (
          <a
            href={link.href}
            class="text-xs md:text-sm font-bold text-zinc-700 hover:text-zinc-950
                   no-underline transition-colors duration-200"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Slot for additional footer content -->
    <slot />

    <!-- Outer Bottom Bar: Social Icons, Copyright, Contact -->
    <div class="mt-8 pt-4 flex flex-col md:flex-row items-center justify-between gap-4 text-stone-500 text-xs md:text-sm">

      <!-- Left: Social Media Icons -->
      <div class="flex items-center gap-4">
        <!-- Instagram -->
        <a
          href="https://www.instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-stone-600 hover:text-brand-gold transition-colors duration-200"
          aria-label="Instagram"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" clip-rule="evenodd" />
          </svg>
        </a>

        <!-- TripAdvisor -->
        <a
          href="https://www.tripadvisor.com/Restaurant_Review-g190441-d25104877-Reviews-D_ouro_Soulfood_Bistro-Salzburg_Austrian_Alps.html"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-stone-600 hover:text-brand-gold transition-colors duration-200"
          aria-label="TripAdvisor"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="6.5" cy="12.5" r="2.5"/>
            <circle cx="17.5" cy="12.5" r="2.5"/>
            <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm-5.5 11c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm11 0c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3z"/>
          </svg>
        </a>

        <!-- Phone / Contact Link -->
        <a
          href={phoneHref}
          class="text-xs text-stone-600 hover:text-brand-gold transition-colors duration-200 no-underline"
        >
          {phone}
        </a>
      </div>

      <!-- Center: Copyright Notice -->
      <div class="text-center">
        <p class="text-stone-500">
          &copy; {currentYear} {copyrightName}. Alle Rechte vorbehalten.
        </p>
      </div>

      <!-- Right: Location -->
      <div class="text-right">
        <p class="text-stone-500">
          {address[0]}
        </p>
      </div>
    </div>
  </div>
</footer>
