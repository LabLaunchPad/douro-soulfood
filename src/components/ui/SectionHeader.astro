---
/**
 * SectionHeader — shared centered/left section heading: eyebrow + display H2
 * + optional constrained description.
 *
 * Extracts the header pattern duplicated across FaqAccordion and PhotoGrid's
 * `center` variant (identical classes, twice the maintenance). Covers the
 * standard scale only (H2 `text-2xl md:text-3xl`).
 *
 * Anti-usage: UserReviews keeps its larger `md:text-4xl` display title plus
 * pause-control block (intentional editorial scale for the social-proof
 * moment); OurStorySection is a dark-band variant (white/gold on espresso);
 * PhotoGrid's `commerce` variant needs the CTA-docked row layout. Do not
 * grow props to absorb these — their differences are deliberate.
 */

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'center' | 'left';
  class?: string;
}

const { eyebrow, title, description, align = 'center', class: className = '' } = Astro.props;
---

<div class:list={['mb-4 md:mb-5', align === 'left' ? 'text-left' : 'text-center', className]}>
  <span class="inline-block text-xs md:text-sm font-semibold text-brand-gold-ink uppercase tracking-wider mb-1">
    {eyebrow}
  </span>
  <h2 class="text-2xl md:text-3xl font-semibold text-text-primary font-display">{title}</h2>
  {description && (
    <p
      class:list={[
        'text-text-secondary mt-1 max-w-[52ch] text-xs md:text-sm',
        align !== 'left' && 'mx-auto',
      ]}
    >
      {description}
    </p>
  )}
</div>
