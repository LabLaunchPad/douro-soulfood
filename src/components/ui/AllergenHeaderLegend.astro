---
/**
 * AllergenHeaderLegend — Top Global or Section-Specific Allergen Key component.
 * - If `allergens` prop is passed: Only displays allergen definitions present in that section.
 * - If `allergens` is omitted: Displays global allergen key.
 */
import FlagIcon from '@/components/ui/FlagIcon.astro';

interface Props {
  allergens?: string[];
  class?: string;
}

const { allergens, class: className = '' } = Astro.props;

const fullMap: Record<string, { codeDisplay: string; de: string; en: string }> = {
  'A': { codeDisplay: 'A', de: 'Gluten', en: 'Gluten' },
  'G': { codeDisplay: 'G/M', de: 'Milch', en: 'Milk' },
  'M': { codeDisplay: 'G/M', de: 'Milch', en: 'Milk' },
  'G/M': { codeDisplay: 'G/M', de: 'Milch', en: 'Milk' },
  'B': { codeDisplay: 'B', de: 'Krebstiere', en: 'Crustaceans' },
  'R': { codeDisplay: 'R', de: 'Weichtiere', en: 'Molluscs' },
  'E': { codeDisplay: 'E', de: 'Erdnüsse', en: 'Peanuts' },
  'F': { codeDisplay: 'F', de: 'Soja', en: 'Soy' },
};

/** Default global list if no section filter is passed */
const defaultGlobalList = ['A', 'G/M', 'B', 'R', 'E', 'F'];

/** Determine active allergen keys */
let activeKeys: string[] = defaultGlobalList;

if (allergens && allergens.length > 0) {
  const normalizedSet = new Set<string>();
  allergens.forEach((code) => {
    if (code === 'G' || code === 'M' || code === 'G/M') {
      normalizedSet.add('G/M');
    } else {
      normalizedSet.add(code);
    }
  });
  activeKeys = Array.from(normalizedSet);
}

/** Unique items for rendering */
const itemsToRender = activeKeys
  .map((k) => fullMap[k])
  .filter(Boolean)
  .filter((item, index, self) => index === self.findIndex((t) => t.codeDisplay === item.codeDisplay));
---

<div class:list={['w-full bg-(--color-bistro-paper) border border-(--color-bistro-paper-border) rounded-sm p-3.5 sm:p-4 shadow-sm', className]}>
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3 text-center md:text-left">
    {/* Label Header with Info Icon */}
    <div class="flex items-center gap-2 shrink-0 font-serif font-bold text-xs uppercase tracking-wider text-(--color-bistro-ink)">
      <svg class="w-4 h-4 text-(--color-bistro-banner-border) shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>ALLERGENE / ALLERGENS:</span>
    </div>

    {/* Allergen Badges Row */}
    <div class="flex flex-wrap items-center justify-center md:justify-start gap-x-3 gap-y-2 text-xs font-sans text-(--color-bistro-text)">
      {itemsToRender.map((item) => (
        <div class="inline-flex items-center gap-1.5 bg-(--color-bistro-paper-alt) border border-(--color-bistro-paper-border) px-2.5 py-1 rounded-sm shadow-xs">
          <span class="px-1.5 py-0.5 rounded bg-(--color-bistro-banner) text-(--color-bistro-banner-text) font-mono font-black text-[11px]">
            {item.codeDisplay}
          </span>
          <span class="font-medium text-(--color-bistro-text-strong)">
            {item.de === item.en ? item.de : `${item.de} / ${item.en}`}
          </span>
        </div>
      ))}
    </div>
  </div>

  {/* Disclaimer Note for Top Global Bar */}
  {!allergens && (
    <div class="max-w-6xl mx-auto pt-2.5 mt-2.5 border-t border-(--color-bistro-paper-border)/70 flex flex-col lg:flex-row items-center justify-between gap-x-6 gap-y-1 text-xs text-(--color-bistro-muted) font-sans italic text-center lg:text-left leading-snug">
      <p class="flex items-center gap-1.5 justify-center lg:justify-start">
        <FlagIcon lang="de" class="w-3.5 h-2.5 rounded-[2px] shadow-xs" />
        <span>Fragen Sie unser Team nach detaillierten Informationen zu Allergenen und Zutaten. Alle Preise inkl. MwSt. Änderungen und Irrtümer vorbehalten.</span>
      </p>
      <p class="flex items-center gap-1.5 justify-center lg:justify-start">
        <FlagIcon lang="uk" class="w-3.5 h-2.5 rounded-[2px] shadow-xs" />
        <span>Please ask our team for detailed information regarding allergens and ingredients. All prices incl. VAT. Subject to changes and errors.</span>
      </p>
    </div>
  )}
</div>
