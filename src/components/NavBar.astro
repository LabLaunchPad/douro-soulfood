---
/**
 * NavBar — Dynamic Dual-State Talkin' Tacos Header & Mobile Capsule Drawer
 *
 * Mobile Features (Matching Reference Images 1 & 2):
 * - Mobile capsule navbar containing German "Speisekarte" button + hamburger icon.
 * - Full-screen dark mobile menu drawer (fixed inset-0) with top header and vertical links.
 * - Desktop dual-state scroll transition (transparent top vs solid dark on scroll).
 */

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  links?: NavLink[];
  brandName?: string;
  brandSubtitle?: string;
  ctaPrimary?: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  class?: string;
}

const {
  links = [
    { label: 'Speisekarte', href: '/menu' },
    { label: 'Catering', href: '/catering' },
    { label: 'Über uns', href: '/about' },
    { label: 'Kontakt', href: '/contact' },
  ],
  ctaPrimary = { label: 'Jetzt bestellen', href: 'https://www.lieferando.at/en/menu/douro' },
  ctaSecondary = { label: 'Reservierung', href: '/contact' },
  class: className = '',
} = Astro.props;
---

<nav
  aria-label="Hauptmenü"
  class:list={[
    'fixed top-0 inset-x-0 z-50 py-3 md:py-4 transition-all duration-300 ease-out',
    className,
  ]}
  data-nav
  data-scrolled="false"
>
  <!-- Dedicated Full-Width Background Layer (Desktop Smooth Fade) -->
  <div
    data-scrolled-bg
    class="absolute inset-0 bg-brand-espresso/95 backdrop-blur-md border-b border-white/10 shadow-2xl transition-opacity duration-300 ease-out pointer-events-none -z-10 opacity-0"
  ></div>

  <div class="relative z-10 mx-auto flex max-w-7xl items-center justify-between px-4 md:px-12">

    <!-- Left: Logo Image Only -->
    <div class="shrink-0">
      <a
        href="/"
        class="flex items-center no-underline hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold rounded-xs"
        aria-label="D'ouro Soulfood Homepage"
      >
        <img
          src="/dourologo.png"
          alt="D'ouro Soulfood Logo"
          class="h-10 md:h-12 w-auto object-contain transition-transform duration-300 hover:scale-105"
        />
      </a>
    </div>

    <!-- Right: Desktop Navigation Container (SSOT: rounded-md) -->
    <div class="hidden md:flex items-center">
      <div
        data-capsule
        class="flex items-center gap-3 rounded-md px-4 py-2 bg-brand-espresso/90 border border-white/15 backdrop-blur-md shadow-2xl transition-all duration-300 ease-out"
      >
        <!-- Nav links -->
        <div class="flex items-center gap-1">
          {links.map((link) => (
            <a
              href={link.href}
              class="px-3.5 py-2 text-sm font-bold tracking-wider uppercase text-white hover:text-brand-gold
                     no-underline transition-colors duration-200 rounded-sm"
            >
              {link.label}
            </a>
          ))}
        </div>

        <!-- Secondary Button (Reservierung — SSOT: rounded-sm = 10px) -->
        {ctaSecondary && (
          <a
            href={ctaSecondary.href}
            class="px-4 py-2 text-sm font-bold tracking-wider uppercase text-white rounded-sm border border-white/20
                   hover:bg-white/10 hover:border-white/40 no-underline transition-all duration-200"
          >
            {ctaSecondary.label}
          </a>
        )}

        <!-- Primary CTA (D'ouro Brand Gold — SSOT: rounded-sm = 10px) -->
        {ctaPrimary && (
          <a
            href={ctaPrimary.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-1.5 px-5 py-2 text-sm font-extrabold tracking-wider uppercase rounded-sm
                   bg-brand-gold hover:bg-brand-gold-light active:bg-brand-gold-dark text-brand-espresso
                   no-underline transition-all duration-200 shadow-md hover:shadow-lg hover:scale-[1.02]"
          >
            <span>{ctaPrimary.label}</span>
            <svg
              class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </a>
        )}
      </div>
    </div>

    <!-- Mobile Navigation Capsule (SSOT: rounded-md container, rounded-sm button) -->
    <div class="flex md:hidden items-center">
      <div class="flex items-center gap-2 bg-brand-espresso/90 border border-white/15 backdrop-blur-md rounded-md px-2.5 py-1.5 shadow-2xl">
        <!-- German "Speisekarte" Link Button (SSOT: rounded-sm = 10px) -->
        <a
          href="/menu"
          class="px-3 py-1 text-xs font-extrabold tracking-wide text-white border border-white/20 rounded-sm
                 hover:bg-white/10 no-underline transition-colors"
        >
          Speisekarte
        </a>

        <!-- Hamburger Icon Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="flex justify-center items-center w-8 h-8 rounded-sm text-white focus:outline-none"
          aria-label="Navigationsmenü öffnen"
          aria-expanded="false"
        >
          <div class="flex flex-col gap-1.5 justify-center items-center w-5 h-5">
            <span class="block h-0.5 w-5 bg-white rounded-full transition-all duration-200" data-line-top></span>
            <span class="block h-0.5 w-5 bg-white rounded-full transition-all duration-200" data-line-mid></span>
            <span class="block h-0.5 w-5 bg-white rounded-full transition-all duration-200" data-line-bot></span>
          </div>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Full-Screen Mobile Drawer Overlay (Top-Left Aligned List) -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-50 bg-brand-espresso/98 backdrop-blur-2xl
         opacity-0 pointer-events-none transition-all duration-300
         md:hidden flex flex-col justify-start gap-8 p-6 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="Navigationsmenü"
  data-open="false"
>
  <!-- Top Bar inside open mobile menu -->
  <div class="flex items-center justify-between w-full shrink-0">
    <a href="/" class="flex items-center no-underline">
      <img src="/dourologo.png" alt="D'ouro Soulfood Logo" class="h-10 w-auto object-contain" />
    </a>

    <!-- Capsule with Speisekarte + Close X Icon (SSOT: rounded-md container, rounded-sm button) -->
    <div class="flex items-center gap-2 bg-brand-espresso/90 border border-white/15 backdrop-blur-md rounded-md px-2.5 py-1.5 shadow-2xl">
      <a
        href="/menu"
        class="px-3 py-1 text-xs font-extrabold tracking-wide text-white border border-white/20 rounded-sm no-underline"
      >
        Speisekarte
      </a>
      <button
        id="mobile-menu-close-btn"
        type="button"
        class="flex justify-center items-center w-8 h-8 text-white focus:outline-none"
        aria-label="Navigationsmenü schließen"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Main Navigation Links List (Top-Left Aligned) -->
  <nav aria-label="Mobile Navigation Drawer" class="flex flex-col items-start text-left gap-6 pt-4 pb-28">
    {links.map((link) => (
      <a
        href={link.href}
        class="text-2xl font-bold tracking-wide uppercase text-white hover:text-brand-gold no-underline transition-colors"
      >
        {link.label}
      </a>
    ))}
  </nav>
</div>

<slot />

<script>
  // Desktop window.scrollY scroll handler
  const nav = document.querySelector('[data-nav]') as HTMLElement;
  const scrolledBg = document.querySelector('[data-scrolled-bg]') as HTMLElement;
  const capsule = document.querySelector('[data-capsule]') as HTMLElement;

  if (nav) {
    const handleScroll = () => {
      const isScrolled = window.scrollY > 20;

      if (isScrolled) {
        nav.dataset.scrolled = 'true';
        if (scrolledBg) scrolledBg.style.opacity = '1';
        if (capsule) {
          capsule.style.backgroundColor = 'transparent';
          capsule.style.borderColor = 'transparent';
          capsule.style.boxShadow = 'none';
        }
      } else {
        nav.dataset.scrolled = 'false';
        if (scrolledBg) scrolledBg.style.opacity = '0';
        if (capsule) {
          capsule.style.backgroundColor = '';
          capsule.style.borderColor = '';
          capsule.style.boxShadow = '';
        }
      }
    };

    handleScroll();
    window.addEventListener('scroll', handleScroll, { passive: true });
  }

  // Mobile drawer menu logic
  const btn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-menu-close-btn');
  const menu = document.getElementById('mobile-menu');

  function openMenu() {
    if (menu) {
      menu.dataset.open = 'true';
      menu.classList.remove('opacity-0', 'pointer-events-none');
    }
    btn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (menu) {
      menu.dataset.open = 'false';
      menu.classList.add('opacity-0', 'pointer-events-none');
    }
    btn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', () => {
    const isOpen = menu?.dataset.open === 'true';
    if (isOpen) closeMenu();
    else openMenu();
  });

  closeBtn?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.dataset.open === 'true') {
      closeMenu();
      btn?.focus();
    }
  });
</script>
