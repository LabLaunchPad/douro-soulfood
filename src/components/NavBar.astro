---
/**
 * NavBar — Dynamic Dual-State Talkin' Tacos Header & Floating Navbar
 *
 * Single Source of Truth (SSOT):
 * - Buttons use `rounded-sm` (--radius-sm = 10px) matching HeroSection & global token spec.
 * - Floating container uses `rounded-md` (--radius-md = 14px) matching card tokens.
 * - Colors map directly to OKLCH @theme tokens (bg-brand-forest, bg-brand-espresso, text-white).
 */

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  links?: NavLink[];
  brandName?: string;
  brandSubtitle?: string;
  ctaPrimary?: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  class?: string;
}

const {
  links = [
    { label: 'Speisekarte', href: '/menu' },
    { label: 'Catering', href: '/catering' },
    { label: 'Über uns', href: '/about' },
    { label: 'Kontakt', href: '/contact' },
  ],
  ctaPrimary = { label: 'Jetzt bestellen', href: 'https://www.lieferando.at/en/menu/douro' },
  ctaSecondary = { label: 'Reservierung', href: '/contact' },
  class: className = '',
} = Astro.props;
---

<nav
  aria-label="Hauptmenü"
  class:list={[
    'fixed top-0 inset-x-0 z-50 transition-all duration-300 ease-out',
    'bg-transparent py-4',
    className,
  ]}
  data-nav
  data-scrolled="false"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 md:px-12">

    <!-- Left: Logo Image Only -->
    <div class="shrink-0">
      <a
        href="/"
        class="flex items-center no-underline hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold rounded-xs"
        aria-label="D'ouro Soulfood Homepage"
      >
        <img
          src="/dourologo.png"
          alt="D'ouro Soulfood Logo"
          class="h-10 md:h-12 w-auto object-contain transition-transform duration-300 hover:scale-105"
        />
      </a>
    </div>

    <!-- Right: Desktop Navigation Floating Container (SSOT: rounded-md) -->
    <div class="hidden md:flex items-center">
      <div
        data-capsule
        class="flex items-center gap-3 bg-brand-espresso/90 border border-white/15 backdrop-blur-md rounded-md px-4 py-2 shadow-2xl transition-all duration-300"
      >
        <!-- Nav links -->
        <div class="flex items-center gap-1">
          {links.map((link) => (
            <a
              href={link.href}
              class="px-3.5 py-2 text-sm font-bold tracking-wider uppercase text-white hover:text-brand-gold
                     no-underline transition-colors duration-200 rounded-sm"
            >
              {link.label}
            </a>
          ))}
        </div>

        <!-- Secondary Button (Reservierung — SSOT: rounded-sm = 10px) -->
        {ctaSecondary && (
          <a
            href={ctaSecondary.href}
            class="px-4 py-2 text-sm font-bold tracking-wider uppercase text-white rounded-sm border border-white/20
                   hover:bg-white/10 hover:border-white/40 no-underline transition-all duration-200"
          >
            {ctaSecondary.label}
          </a>
        )}

        <!-- Primary CTA (D'ouro Brand Gold — SSOT: rounded-sm = 10px) -->
        {ctaPrimary && (
          <a
            href={ctaPrimary.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-1.5 px-5 py-2 text-sm font-extrabold tracking-wider uppercase rounded-sm
                   bg-brand-gold hover:bg-brand-gold-light active:bg-brand-gold-dark text-brand-espresso
                   no-underline transition-all duration-200 shadow-md hover:shadow-lg hover:scale-[1.02]"
          >
            <span>{ctaPrimary.label}</span>
            <svg
              class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </a>
        )}
      </div>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex items-center gap-2 md:hidden">
      {ctaPrimary && (
        <a
          href={ctaPrimary.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-bold uppercase rounded-sm
                 bg-brand-gold text-brand-espresso no-underline"
        >
          Bestellen
        </a>
      )}
      <button
        id="mobile-menu-btn"
        type="button"
        class="flex justify-center items-center w-10 h-10 rounded-sm bg-brand-espresso/90 border border-white/15 text-white"
        aria-label="Navigationsmenü öffnen"
        aria-expanded="false"
      >
        <div class="flex flex-col gap-1.5 justify-center items-center w-5 h-5">
          <span class="block h-0.5 w-5 bg-white rounded-full transition-transform duration-200" data-line-top></span>
          <span class="block h-0.5 w-5 bg-white rounded-full transition-opacity duration-200" data-line-mid></span>
          <span class="block h-0.5 w-5 bg-white rounded-full transition-transform duration-200" data-line-bot></span>
        </div>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu"
  class="fixed top-20 right-0 bottom-0 left-0 z-40 bg-brand-espresso/98 backdrop-blur-xl
         opacity-0 pointer-events-none transition-opacity duration-300
         md:hidden overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="Navigationsmenü"
  data-open="false"
>
  <div class="mx-auto max-w-7xl px-6 py-8">
    <nav aria-label="Mobile Navigation" class="flex flex-col gap-3">
      {links.map((link) => (
        <a
          href={link.href}
          class="flex items-center px-4 py-3 text-lg font-bold tracking-wider uppercase
                 text-white rounded-sm hover:bg-white/10 no-underline transition-colors"
        >
          {link.label}
        </a>
      ))}
      {ctaSecondary && (
        <a
          href={ctaSecondary.href}
          class="flex items-center justify-center px-4 py-3 text-lg font-bold tracking-wider uppercase
                 text-white border border-white/20 rounded-sm hover:bg-white/10 no-underline transition-colors mt-2"
        >
          {ctaSecondary.label}
        </a>
      )}
      {ctaPrimary && (
        <a
          href={ctaPrimary.href}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 flex items-center justify-center gap-2 px-5 py-3 text-lg font-extrabold tracking-wider uppercase
                 bg-brand-gold text-brand-espresso rounded-sm no-underline shadow-lg"
        >
          <span>{ctaPrimary.label}</span>
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      )}
    </nav>
  </div>
</div>

<slot />

<script>
  // Scroll Sentinel for Dynamic Dual-State Navbar
  const nav = document.querySelector('[data-nav]') as HTMLElement;
  const capsule = document.querySelector('[data-capsule]') as HTMLElement;

  if (nav) {
    const sentinel = document.createElement('div');
    sentinel.style.position = 'absolute';
    sentinel.style.top = '0px';
    sentinel.style.height = '20px';
    sentinel.style.width = '100%';
    sentinel.style.pointerEvents = 'none';
    document.body.prepend(sentinel);

    const observer = new IntersectionObserver(
      ([entry]) => {
        const isTop = entry.isIntersecting;
        nav.dataset.scrolled = String(!isTop);

        if (!isTop) {
          // Scrolled State: Full width dark bar header
          nav.classList.remove('bg-transparent', 'py-4');
          nav.classList.add('bg-brand-espresso/95', 'backdrop-blur-md', 'border-b', 'border-white/10', 'py-3', 'shadow-2xl');

          capsule?.classList.remove('bg-brand-espresso/90', 'border-white/15', 'shadow-2xl');
          capsule?.classList.add('bg-transparent', 'border-transparent', 'shadow-none');
        } else {
          // Top State: Transparent header with floating dark capsule
          nav.classList.add('bg-transparent', 'py-4');
          nav.classList.remove('bg-brand-espresso/95', 'backdrop-blur-md', 'border-b', 'border-white/10', 'py-3', 'shadow-2xl');

          capsule?.classList.add('bg-brand-espresso/90', 'border-white/15', 'shadow-2xl');
          capsule?.classList.remove('bg-transparent', 'border-transparent', 'shadow-none');
        }
      },
      { threshold: 0.1 }
    );

    observer.observe(sentinel);
  }

  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  function closeMenu() {
    if (menu) {
      menu.dataset.open = 'false';
      menu.classList.add('opacity-0', 'pointer-events-none');
    }
    btn?.setAttribute('aria-expanded', 'false');

    const topLine = btn?.querySelector('[data-line-top]');
    const midLine = btn?.querySelector('[data-line-mid]');
    const botLine = btn?.querySelector('[data-line-bot]');

    topLine?.classList.remove('rotate-45', 'translate-y-2');
    midLine?.classList.remove('opacity-0');
    botLine?.classList.remove('-rotate-45', '-translate-y-2');
  }

  btn?.addEventListener('click', () => {
    const isOpen = menu?.dataset.open === 'true';

    if (menu) {
      menu.dataset.open = String(!isOpen);
      menu.classList.toggle('opacity-0', isOpen);
      menu.classList.toggle('pointer-events-none', isOpen);
    }

    btn.setAttribute('aria-expanded', String(!isOpen));

    const topLine = btn.querySelector('[data-line-top]');
    const midLine = btn.querySelector('[data-line-mid]');
    const botLine = btn.querySelector('[data-line-bot]');

    if (!isOpen) {
      topLine?.classList.add('rotate-45', 'translate-y-2');
      midLine?.classList.add('opacity-0');
      botLine?.classList.add('-rotate-45', '-translate-y-2');
    } else {
      topLine?.classList.remove('rotate-45', 'translate-y-2');
      midLine?.classList.remove('opacity-0');
      botLine?.classList.remove('-rotate-45', '-translate-y-2');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.dataset.open === 'true') {
      closeMenu();
      btn?.focus();
    }
  });
</script>
