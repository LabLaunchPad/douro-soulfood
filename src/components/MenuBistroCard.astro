---
import { Image } from 'astro:assets';
import siteSettings from '@/content/settings/default.json';

const orderHref = siteSettings.foodora_url || siteSettings.lieferando_url || 'https://www.foodora.at/en/restaurant/noch/douro-soulfood-bistro';

interface Props {
  name: string;
  description: string;
  descriptionEn?: string;
  priceInCents: number;
  priceDisplay?: string;
  priceVariants?: { nonAlcoholic?: number; alcoholic?: number };
  prepTime?: string;
  prepTimeEn?: string;
  allergens?: string[];
  addOns?: { label: string; price: number }[];
  imageSrc?: string;
  imageAlt?: string;
  available?: boolean;
  class?: string;
}

const {
  name,
  description,
  descriptionEn,
  priceInCents,
  priceDisplay,
  priceVariants,
  prepTime,
  prepTimeEn,
  allergens = [],
  addOns = [],
  imageSrc,
  imageAlt = '',
  available = true,
  class: className = '',
} = Astro.props;

/** Format price from cents to EUR display string e.g. €8,90 */
const formatPrice = (cents: number): string => {
  const euros = cents / 100;
  return new Intl.NumberFormat('de-DE', {
    style: 'currency',
    currency: 'EUR',
    minimumFractionDigits: 2,
  }).format(euros);
};

const formattedPrice = priceDisplay || formatPrice(priceInCents);

/** Dual price display for items with alcoholic/non-alcoholic variants */
const hasDualPrice = priceVariants?.nonAlcoholic !== undefined && priceVariants?.alcoholic !== undefined;
const dualPriceDisplay = hasDualPrice
  ? `${formatPrice(priceVariants!.nonAlcoholic!)} / ${formatPrice(priceVariants!.alcoholic!)}`
  : null;

/** Allergen code display format: (A, M) */
const allergenString = allergens.length > 0 ? `(${allergens.join(', ')})` : '';
---

<article
  class:list={[
    'group relative flex flex-row justify-between items-start md:items-center rounded-2xl p-3.5 sm:p-4 md:p-4 bg-[#FFFDF9] border border-[#E8DFC8] shadow-sm hover:shadow-md hover:border-[#D6C4A5] transition-all duration-200 gap-3.5 sm:gap-4 md:gap-5 overflow-hidden w-full max-w-full',
    !available && 'opacity-60',
    className,
  ]}
>
  {/* Entire Card Clickable Link */}
  <a
    href={orderHref}
    target="_blank"
    rel="noopener noreferrer"
    class="absolute inset-0 z-20 rounded-2xl focus:outline-none focus:ring-2 focus:ring-amber-600"
    aria-label={`Jetzt ${name} bestellen`}
  ></a>

  {/* Image Column — Mobile (< md): Right side (order-2, w-24 h-24). Desktop (>= md): Left side (md:order-1, md:w-36 md:h-36 lg:w-40 lg:h-40) */}
  {imageSrc && (
    <div class="w-24 h-24 sm:w-28 sm:h-28 md:w-36 md:h-36 lg:w-40 lg:h-40 shrink-0 aspect-square rounded-xl overflow-hidden relative shadow-inner bg-stone-100 self-start md:self-center order-2 md:order-1">
      <Image
        src={imageSrc}
        alt={imageAlt || name}
        width={400}
        height={400}
        format="webp"
        quality={85}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 ease-out"
        loading="lazy"
      />
    </div>
  )}

  {/* Details Column — Mobile (< md): Left side (order-1). Desktop (>= md): Right side (md:order-2) */}
  <div class="flex flex-col justify-center flex-1 py-0.5 md:py-1 min-w-0 gap-1.5 sm:gap-2 self-start md:self-center w-full order-1 md:order-2">
    <div>
      {/* Title + Highlighted Price Header */}
      <div class="flex items-center justify-between gap-2 w-full mb-2">
        <h3 class="text-sm sm:text-base md:text-lg font-serif font-black text-[#2C1810] tracking-wide uppercase break-words leading-snug min-w-0 flex-1 self-center">
          {name}
        </h3>

        {/* Highlighted Price Badge — dual or single */}
        {hasDualPrice ? (
          <div class="shrink-0 flex flex-col items-end gap-1 ml-1 self-center">
            <div class="font-serif font-extrabold text-[#F4E3B3] bg-[#1B140E] border border-[#D4AF37]/50 px-3 py-1 rounded-xl shadow-xs text-sm sm:text-base tracking-wide whitespace-nowrap">
              {dualPriceDisplay}
            </div>
            <div class="flex flex-col items-end gap-0.5">
              <div class="flex items-center gap-1">
                <svg class="w-3.5 h-2.5 rounded-[2px] shadow-xs shrink-0" viewBox="0 0 5 3" aria-hidden="true">
                  <rect width="5" height="1" y="0" fill="#000000"/>
                  <rect width="5" height="1" y="1" fill="#DD0000"/>
                  <rect width="5" height="1" y="2" fill="#FFCE00"/>
                </svg>
                <span class="text-[10px] text-stone-500 font-sans font-medium tracking-wide whitespace-nowrap">ohne / mit Alkohol</span>
              </div>
              <div class="flex items-center gap-1">
                <svg class="w-3.5 h-2.5 rounded-[2px] shadow-xs shrink-0" viewBox="0 0 60 30" aria-hidden="true">
                  <clipPath id="uk-clip-dual"><path d="M0,0 v30 h60 v-30 z"/></clipPath>
                  <clipPath id="uk-diag-dual"><path d="M0,0 L60,30 M60,0 L0,30"/></clipPath>
                  <g clip-path="url(#uk-clip-dual)">
                    <path d="M0,0 v30 h60 v-30 z" fill="#012169"/>
                    <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" clip-path="url(#uk-diag-dual)"/>
                    <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4" clip-path="url(#uk-diag-dual)"/>
                    <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/>
                    <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/>
                  </g>
                </svg>
                <span class="text-[10px] text-stone-500 font-sans font-medium tracking-wide whitespace-nowrap">non-alc. / alcoholic</span>
              </div>
            </div>
          </div>
        ) : (
          <div class="shrink-0 font-serif font-extrabold text-[#F4E3B3] bg-[#1B140E] border border-[#D4AF37]/50 px-3 py-1 rounded-xl shadow-xs text-sm sm:text-base md:text-lg tracking-wide whitespace-nowrap self-center ml-1">
            {formattedPrice}
            {prepTime && (
              <span class="text-xs font-normal text-[#F4E3B3]/80 ml-1">({prepTime})</span>
            )}
          </div>
        )}
      </div>

      {/* Language 1: German with SVG Flag */}
      {description && (
        <div class="flex items-start gap-1.5 sm:gap-2 mb-1.5 text-xs sm:text-sm text-stone-800 leading-snug">
          <svg class="w-4 h-3 rounded-[2px] shadow-xs shrink-0 mt-0.5 sm:mt-1" viewBox="0 0 5 3" aria-hidden="true">
            <rect width="5" height="1" y="0" fill="#000000"/>
            <rect width="5" height="1" y="1" fill="#DD0000"/>
            <rect width="5" height="1" y="2" fill="#FFCE00"/>
          </svg>
          <p class="font-sans font-medium break-words min-w-0">{description}</p>
        </div>
      )}

      {/* Prep time in German if detailed */}
      {prepTime && (
        <div class="flex items-center gap-1.5 ml-5 sm:ml-6 mb-1.5 text-[11px] sm:text-xs text-amber-900/90 italic">
          <span class="text-xs">⏱️</span>
          <span>Wartezeit ca. {prepTime}.</span>
        </div>
      )}

      {/* Language 2: English with SVG Flag */}
      {descriptionEn && (
        <div class="flex items-start gap-1.5 sm:gap-2 text-xs sm:text-sm text-stone-600 leading-snug">
          <svg class="w-4 h-3 rounded-[2px] shadow-xs shrink-0 mt-0.5 sm:mt-1" viewBox="0 0 60 30" aria-hidden="true">
            <clipPath id="uk-clip-card-single"><path d="M0,0 v30 h60 v-30 z"/></clipPath>
            <clipPath id="uk-diag-card-single"><path d="M0,0 L60,30 M60,0 L0,30"/></clipPath>
            <g clip-path="url(#uk-clip-card-single)">
              <path d="M0,0 v30 h60 v-30 z" fill="#012169"/>
              <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" clip-path="url(#uk-diag-card-single)"/>
              <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4" clip-path="url(#uk-diag-card-single)"/>
              <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/>
              <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/>
            </g>
          </svg>
          <p class="font-sans break-words min-w-0">{descriptionEn}</p>
        </div>
      )}

      {/* Prep time in English if detailed */}
      {prepTimeEn && (
        <div class="flex items-center gap-1.5 ml-5 sm:ml-6 mt-0.5 text-[11px] sm:text-xs text-stone-500 italic">
          <span class="text-xs">⏱️</span>
          <span>Waiting time {prepTimeEn}.</span>
        </div>
      )}
      {/* Add-ons tag (e.g. + Frango (Chicken) + €3,00) */}
      {addOns.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-2">
          {addOns.map((addon) => (
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-amber-950 bg-amber-100/90 border border-amber-900/20 px-2.5 py-0.5 rounded-lg shadow-xs">
              + {addon.label} (+{formatPrice(addon.price)})
            </span>
          ))}
        </div>
      )}
    </div>

    {/* Allergen Codes */}
    {allergens.length > 0 && (
      <div class="mt-1 pt-0.5 text-xs sm:text-sm font-serif font-bold text-amber-900">
        {allergenString}
      </div>
    )}
  </div>
</article>
