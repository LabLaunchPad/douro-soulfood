---
export const prerender = true;

import Base from '@/layouts/Base.astro';
import NavBar from '@/components/NavBar.astro';
import Footer from '@/components/Footer.astro';
import MenuItemCard from '@/components/MenuItemCard.astro';
import MenuBistroCard from '@/components/MenuBistroCard.astro';
import AllergenHeaderLegend from '@/components/AllergenHeaderLegend.astro';
import CategoryIcon from '@/components/CategoryIcon.astro';
import { getCollection } from 'astro:content';

/**
 * MENU PAGE — D'ouro Soulfood Bistro
 */

type DietaryTag = 'vegan' | 'vegetarian' | 'gluten-free' | 'spicy' | 'halal' | 'dairy-free';

/** Category display config — controls order, labels, and vector icon names */
const categoryConfig: Record<string, { label: string; order: number; icon: string }> = {
  'appetizers':   { label: 'Vorspeisen / Entradas',  order: 10, icon: 'appetizers' },
  'quesadillas':  { label: 'Quesadillas',            order: 20, icon: 'quesadillas' },
  'tacos':        { label: 'Tacos',                  order: 30, icon: 'tacos' },
  'bowls':        { label: 'Bowls',                  order: 40, icon: 'bowls' },
  'mains':        { label: 'Pratos Feitos',          order: 50, icon: 'mains' },
  'seafood':      { label: 'Pratos Do Mar',          order: 60, icon: 'seafood' },
  'sides':        { label: 'Beilagen / Sides',       order: 65, icon: 'sides' },
  'drinks':       { label: 'Bebidas',                order: 70, icon: 'drinks' },
  'desserts':     { label: 'Sobremesas',             order: 80, icon: 'desserts' },
};

/** Sub-category titles & icons for Bebidas section */
const drinkSubLabels: Record<string, { label: string; icon: string }> = {
  'aguas-frescas': { label: 'Águas Frescas', icon: '🍹' },
  'cocktails':     { label: 'Cocktails',     icon: '🍸' },
  'softdrinks':    { label: 'Softdrinks',    icon: '🥤' },
  'cafes':         { label: 'Cafés',         icon: '☕' },
};

/** Fetch all menu items from KeystaticCMS */
const allItems = await getCollection('menu_items');

/** Filter to only available items, sort by category order then item order */
const menuItems = allItems
  .filter((item) => item.data.available !== false)
  .sort((a, b) => {
    const catA = categoryConfig[a.data.category]?.order ?? 99;
    const catB = categoryConfig[b.data.category]?.order ?? 99;
    if (catA !== catB) return catA - catB;
    return (a.data.order ?? 0) - (b.data.order ?? 0);
  });

/** Group items by category */
const grouped = menuItems.reduce<Record<string, typeof menuItems>>((acc, item) => {
  const cat = item.data.category || 'other';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(item);
  return acc;
}, {});

/** Sort categories by their display order */
const sortedCategories = Object.entries(grouped).sort(
  ([a], [b]) => (categoryConfig[a]?.order ?? 99) - (categoryConfig[b]?.order ?? 99)
);
---

<Base title="Speisekarte">
  <NavBar slot="nav" />

  <!-- ═══ HERO HEADER ═══ -->
  <section class="pt-24 pb-4 md:pt-20 md:pb-4 px-4 md:px-16 max-w-7xl mx-auto">
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-brand-gold mb-6 font-display uppercase tracking-tight">
      Speisekarte
    </h1>
    <p class="text-lg md:text-xl text-text-secondary max-w-[75ch] leading-relaxed">
      Jedes Gericht wird frisch und von Hand zubereitet — mit den Aromen Brasiliens und der Wärme Afrikas.
      Angela kocht alles selbst, mit Liebe und den besten Zutaten.
    </p>

    <!-- Quick category navigation -->
    <nav class="flex flex-wrap gap-2.5 mt-8 mb-4" aria-label="Menü-Kategorien">
      {sortedCategories.map(([slug]) => {
        const config = categoryConfig[slug];
        if (!config) return null;
        return (
          <a
            href={`#category-${slug}`}
            class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-bold uppercase tracking-wider rounded-lg
                   bg-surface-card border border-border-subtle text-text-secondary
                   hover:bg-surface-elevated hover:border-brand-gold hover:text-brand-gold
                   active:bg-surface-primary
                   focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold
                   no-underline transition-all duration-[var(--duration-fast)] ease-[var(--ease-spring)]"
          >
            <CategoryIcon name={config.icon} class="w-4 h-4 text-brand-gold" />
            {config.label}
          </a>
        );
      })}
    </nav>

    {/* Top Allergen Legend matching bistro menu reference */}
    <AllergenHeaderLegend />
  </section>

  <!-- ═══ MENU CATEGORIES ═══ -->
  {sortedCategories.map(([slug, items]) => {
    const config = categoryConfig[slug] ?? { label: slug, order: 99, icon: 'mains' };

    // Special layout for Bebidas: Render 4 sub-categories (Águas Frescas, Cocktails, Softdrinks, Cafés)
    if (slug === 'drinks') {
      const subCategoryOrder = ['aguas-frescas', 'cocktails', 'softdrinks', 'cafes'];
      const subGrouped = subCategoryOrder.map((subSlug) => {
        const subItems = items.filter((item) => item.data.subCategory === subSlug || (!item.data.subCategory && subSlug === 'softdrinks'));
        return { subSlug, subItems };
      }).filter(({ subItems }) => subItems.length > 0);

      return (
        <section
          id={`category-${slug}`}
          class="py-8 md:py-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20"
        >
          {/* Main category heading */}
          <div class="flex items-center gap-3.5 mb-10">
            <div class="w-10 h-10 rounded-xl bg-brand-gold/15 text-brand-gold flex items-center justify-center">
              <CategoryIcon name={config.icon} class="w-6 h-6" />
            </div>
            <h2 class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-text-primary font-display uppercase tracking-wider">
              {config.label}
            </h2>
            <div class="flex-1 h-0.5 bg-border-subtle ml-2"></div>
          </div>

          {/* Sub-categories loop */}
          <div class="space-y-12">
            {subGrouped.map(({ subSlug, subItems }) => {
              const subMeta = drinkSubLabels[subSlug] ?? { label: subSlug, icon: '🍹' };
              return (
                <div class="space-y-6">
                  {/* Sub-category header */}
                  <div class="flex items-center gap-2.5 pb-2 border-b border-border-subtle/60">
                    <span class="text-xl" aria-hidden="true">{subMeta.icon}</span>
                    <h3 class="text-lg md:text-xl font-bold text-brand-gold font-display uppercase tracking-wide">
                      {subMeta.label}
                    </h3>
                  </div>

                  {/* Sub-category grid */}
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
                    {subItems.map((item) => (
                      <MenuItemCard
                        name={item.data.title}
                        description={item.data.description}
                        priceInCents={item.data.price}
                        priceVariants={item.data.priceVariants}
                        dietary={item.data.dietary as DietaryTag[] | undefined}
                        allergens={item.data.allergens}
                        prepTime={item.data.prepTime}
                        addOns={item.data.addOns}
                        available={item.data.available}
                        featured={item.data.featured}
                        imageSrc={item.data.image || undefined}
                        imageAlt={item.data.title}
                        imageWidth={400}
                        imageHeight={300}
                      />
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      );
    }

    // Special layout for Entradas (Appetizers): Bistro paper menu layout
    if (slug === 'appetizers') {
      return (
        <section
          id={`category-${slug}`}
          class="pt-2 pb-8 md:pt-4 md:pb-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20"
        >
          {/* Category Banner Header */}
          <div class="flex justify-center mb-6">
            <div class="inline-flex items-center gap-3 bg-[#1B140E] border-2 border-[#D4AF37] px-6 sm:px-10 py-3 rounded-2xl shadow-lg text-center">
              <h2 class="text-xl sm:text-2xl md:text-3xl font-serif font-extrabold text-[#F4E3B3] tracking-widest uppercase">
                {config.label}
              </h2>
            </div>
          </div>

          {/* Entradas Bistro Cards Grid: 2 cards per row on desktop/tablet */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
            {items.map((item) => (
              <MenuBistroCard
                name={item.data.title}
                description={item.data.description}
                descriptionEn={item.data.descriptionEn}
                priceInCents={item.data.price}
                prepTime={item.data.prepTime}
                prepTimeEn={item.data.prepTimeEn}
                allergens={item.data.allergens}
                imageSrc={item.data.image || undefined}
                imageAlt={item.data.title}
                available={item.data.available}
              />
            ))}
          </div>

          {/* Section-Specific Allergen Legend */}
          <div class="mt-6">
            <AllergenHeaderLegend allergens={items.flatMap((i) => i.data.allergens || [])} />
          </div>
        </section>
      );
    }

    // Special layout for Quesadillas: Option B (Category Feature Banner + Bistro Cards Grid)
    if (slug === 'quesadillas') {
      return (
        <section
          id={`category-${slug}`}
          class="pt-4 pb-8 md:pt-6 md:pb-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20"
        >
          {/* Category Banner Header */}
          <div class="flex justify-center mb-6">
            <div class="inline-flex items-center gap-3 bg-[#1B140E] border-2 border-[#D4AF37] px-6 sm:px-10 py-3 rounded-2xl shadow-lg text-center">
              <h2 class="text-xl sm:text-2xl md:text-3xl font-serif font-extrabold text-[#F4E3B3] tracking-widest uppercase">
                {config.label}
              </h2>
            </div>
          </div>

          {/* Category Showcase Image Banner (Strict 1:1 Compact Square Photo Only) */}
          <div class="mb-6 rounded-2xl overflow-hidden bg-[#FFFDF9] border border-[#E8DFC8] shadow-sm p-3 max-w-xs sm:max-w-sm mx-auto flex justify-center">
            <div class="w-full aspect-square rounded-xl overflow-hidden shadow-inner bg-stone-100">
              <img
                src="/images/menu/Quesadillas.webp"
                alt="D'ouro Quesadillas"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          </div>

          {/* Quesadillas Bistro Cards Grid */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
            {items.map((item) => (
              <MenuBistroCard
                name={item.data.title}
                description={item.data.description}
                descriptionEn={item.data.descriptionEn}
                priceInCents={item.data.price}
                prepTime={item.data.prepTime}
                prepTimeEn={item.data.prepTimeEn}
                allergens={item.data.allergens}
                imageSrc={item.data.image || undefined}
                imageAlt={item.data.title}
                available={item.data.available}
              />
            ))}
          </div>

          {/* Section-Specific Allergen Legend */}
          <div class="mt-6">
            <AllergenHeaderLegend allergens={items.flatMap((i) => i.data.allergens || [])} />
          </div>
        </section>
      );
    }

    // Special layout for Tacos: 3-Photo Showcase Row + Bistro Cards Grid
    if (slug === 'tacos') {
      return (
        <section
          id={`category-${slug}`}
          class="pt-4 pb-8 md:pt-6 md:pb-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20"
        >
          {/* Category Banner Header */}
          <div class="flex justify-center mb-6">
            <div class="inline-flex items-center gap-3 bg-[#1B140E] border-2 border-[#D4AF37] px-6 sm:px-10 py-3 rounded-2xl shadow-lg text-center">
              <h2 class="text-xl sm:text-2xl md:text-3xl font-serif font-extrabold text-[#F4E3B3] tracking-widest uppercase">
                {config.label}
              </h2>
            </div>
          </div>

          {/* 3-Photo Showcase Row (Each photo matches Quesadillas photo height) */}
          <div class="mb-8 rounded-2xl overflow-hidden bg-[#FFFDF9] border border-[#E8DFC8] shadow-sm p-3.5 sm:p-5 max-w-4xl lg:max-w-5xl mx-auto">
            <div class="grid grid-cols-3 gap-3 sm:gap-4">
              <div class="w-full aspect-square rounded-xl overflow-hidden shadow-inner bg-stone-100">
                <img
                  src="/images/menu/tacos1.webp"
                  alt="D'ouro Taco Showcase 1"
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="w-full aspect-square rounded-xl overflow-hidden shadow-inner bg-stone-100">
                <img
                  src="/images/menu/tacos2.webp"
                  alt="D'ouro Taco Showcase 2"
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="w-full aspect-square rounded-xl overflow-hidden shadow-inner bg-stone-100">
                <img
                  src="/images/menu/tacos3.webp"
                  alt="D'ouro Taco Showcase 3"
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
            </div>
          </div>

          {/* Tacos Bistro Cards Grid */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
            {items.map((item) => (
              <MenuBistroCard
                name={item.data.title}
                description={item.data.description}
                descriptionEn={item.data.descriptionEn}
                priceInCents={item.data.price}
                prepTime={item.data.prepTime}
                prepTimeEn={item.data.prepTimeEn}
                allergens={item.data.allergens}
                imageSrc={item.data.image || undefined}
                imageAlt={item.data.title}
                available={item.data.available}
              />
            ))}
          </div>

          {/* Section-Specific Allergen Legend */}
          <div class="mt-6">
            <AllergenHeaderLegend allergens={items.flatMap((i) => i.data.allergens || [])} />
          </div>
        </section>
      );
    }

    return (
      <section
        id={`category-${slug}`}
        class="py-8 md:py-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20"
      >
        {/* Category heading */}
        <div class="flex items-center gap-3.5 mb-8">
          <div class="w-10 h-10 rounded-xl bg-brand-gold/15 text-brand-gold flex items-center justify-center">
            <CategoryIcon name={config.icon} class="w-6 h-6" />
          </div>
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-text-primary font-display uppercase tracking-wider">
            {config.label}
          </h2>
          <div class="flex-1 h-0.5 bg-border-subtle ml-2"></div>
        </div>

        {/* Menu items grid */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
          {items.map((item) => (
            <MenuItemCard
              name={item.data.title}
              description={item.data.description}
              priceInCents={item.data.price}
              priceVariants={item.data.priceVariants}
              dietary={item.data.dietary as DietaryTag[] | undefined}
              allergens={item.data.allergens}
              prepTime={item.data.prepTime}
              addOns={item.data.addOns}
              available={item.data.available}
              featured={item.data.featured}
              imageSrc={item.data.image || undefined}
              imageAlt={item.data.title}
              imageWidth={400}
              imageHeight={300}
            />
          ))}
        </div>
      </section>
    );
  })}

  <!-- ═══ EMPTY STATE ═══ -->
  {sortedCategories.length === 0 && (
    <section class="py-16 px-4 md:px-16 max-w-7xl mx-auto text-center" aria-label="Leere Speisekarte">
      <p class="text-text-tertiary text-lg py-20">
        Die Speisekarte wird gerade aktualisiert. Bitte schauen Sie später vorbei!
      </p>
    </section>
  )}

  <!-- ═══ ALLERGEN LEGEND & NOTE ═══ -->
  <section class="py-8 md:py-12 px-4 md:px-16 max-w-7xl mx-auto">
    <div class="rounded-xl bg-surface-card border border-border-subtle p-6 flex flex-col gap-4">
      <h3 class="text-sm font-semibold text-brand-gold uppercase tracking-wider flex items-center gap-2">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="16" x2="12" y2="12" />
          <line x1="12" y1="8" x2="12.01" y2="8" />
        </svg>
        Allergene & Zusatzstoffe (EU-Kennzeichnung)
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2 text-xs text-text-secondary">
        <div class="flex items-center gap-1.5"><span class="px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold">A</span> Glutenhaltiges Getreide</div>
        <div class="flex items-center gap-1.5"><span class="px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold">M / G</span> Milch / Laktose</div>
        <div class="flex items-center gap-1.5"><span class="px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold">B</span> Krebstiere</div>
        <div class="flex items-center gap-1.5"><span class="px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold">R</span> Weichtiere</div>
        <div class="flex items-center gap-1.5"><span class="px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold">E</span> Erdnüsse</div>
        <div class="flex items-center gap-1.5"><span class="px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold">F</span> Soja</div>
      </div>
      <p class="text-xs text-text-tertiary border-t border-border-subtle pt-3 leading-relaxed">
        Fragen Sie unser Team nach detaillierten Informationen zu Allergenen und Zutaten. Alle Preise inkl. MwSt. Änderungen und Irrtümer vorbehalten.
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
