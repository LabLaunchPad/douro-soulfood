---
export const prerender = true;

import Base from '@/layouts/Base.astro';
import NavBar from '@/components/NavBar.astro';
import Footer from '@/components/Footer.astro';
import MenuItemCard from '@/components/MenuItemCard.astro';
import MenuBistroCard from '@/components/MenuBistroCard.astro';
import CategoryBanner from '@/components/menu/CategoryBanner.astro';
import CategoryShowcase from '@/components/menu/CategoryShowcase.astro';
import AllergenHeaderLegend from '@/components/AllergenHeaderLegend.astro';
import CategoryIcon from '@/components/CategoryIcon.astro';
import { getCollection } from 'astro:content';

/**
 * MENU PAGE — D'ouro Soulfood Bistro
 */

type DietaryTag = 'vegan' | 'vegetarian' | 'gluten-free' | 'spicy' | 'halal' | 'dairy-free';

interface ShowcaseImage {
  src: string;
  alt: string;
}

/**
 * Category display config — controls order, labels, vector icon names,
 * and the "bistro paper" presentation (banner subtitle + optional
 * 3-photo showcase row) used by the shared category renderer below.
 */
const categoryConfig: Record<
  string,
  { label: string; order: number; icon: string; subtitle?: string; showcaseImages?: ShowcaseImage[] }
> = {
  appetizers: { label: 'Vorspeisen / Entradas', order: 10, icon: 'appetizers' },
  quesadillas: {
    label: 'Quesadillas',
    order: 20,
    icon: 'quesadillas',
    showcaseImages: [
      { src: '/images/menu/Quesadillas.webp', alt: "D'ouro Quesadillas" },
      { src: '/images/menu/quesdillas2.webp', alt: "D'ouro Quesadillas 2" },
      { src: '/images/menu/ques3.webp', alt: "D'ouro Quesadillas 3" },
    ],
  },
  tacos: {
    label: 'Tacos',
    order: 30,
    icon: 'tacos',
    showcaseImages: [
      { src: '/images/menu/tacos1.webp', alt: "D'ouro Taco Showcase 1" },
      { src: '/images/menu/tacos2.webp', alt: "D'ouro Taco Showcase 2" },
      { src: '/images/menu/tacos3.webp', alt: "D'ouro Taco Showcase 3" },
    ],
  },
  bowls: {
    label: 'Bowls',
    order: 40,
    icon: 'bowls',
    subtitle: '(1 Stk. / 1 Piece)',
    showcaseImages: [
      { src: '/images/menu/bowl1.jfif', alt: "D'ouro Bowls Showcase 1" },
      { src: '/images/menu/bowl2.jfif', alt: "D'ouro Bowls Showcase 2" },
      { src: '/images/menu/bowl3.jfif', alt: "D'ouro Bowls Showcase 3" },
    ],
  },
  mains: { label: 'Pratos Feitos', order: 50, icon: 'mains' },
  seafood: { label: 'Pratos Do Mar', order: 60, icon: 'seafood' },
  sides: { label: 'Beilagen / Sides', order: 65, icon: 'sides' },
  drinks: { label: 'Bebidas', order: 70, icon: 'drinks' },
  desserts: { label: 'Sobremesas', order: 80, icon: 'desserts' },
};

/** Categories rendered with the shared "bistro paper" banner + card grid layout */
const bistroCategorySlugs = new Set(['appetizers', 'quesadillas', 'tacos', 'bowls', 'mains', 'seafood', 'desserts']);

/** Sub-category titles & icons for Bebidas section */
const drinkSubLabels: Record<string, { label: string; icon: string }> = {
  'aguas-frescas': { label: 'Águas Frescas', icon: '🍹' },
  cocktails: { label: 'Cocktails', icon: '🍸' },
  softdrinks: { label: 'Softdrinks', icon: '🥤' },
  cafes: { label: 'Cafés', icon: '☕' },
};

/** Fetch all menu items from KeystaticCMS */
const allItems = await getCollection('menu_items');

/** Filter to only available items, sort by category order then item order */
const menuItems = allItems
  .filter((item) => item.data.available !== false)
  .sort((a, b) => {
    const catA = categoryConfig[a.data.category]?.order ?? 99;
    const catB = categoryConfig[b.data.category]?.order ?? 99;
    if (catA !== catB) return catA - catB;
    return (a.data.order ?? 0) - (b.data.order ?? 0);
  });

/** Group items by category */
const grouped = menuItems.reduce<Record<string, typeof menuItems>>((acc, item) => {
  const cat = item.data.category || 'other';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(item);
  return acc;
}, {});

/** Sort categories by their display order */
const sortedCategories = Object.entries(grouped).sort(
  ([a], [b]) => (categoryConfig[a]?.order ?? 99) - (categoryConfig[b]?.order ?? 99)
);
---

<Base title="Speisekarte">
  <NavBar slot="nav" />

  <!-- ═══ HERO HEADER ═══ -->
  <section class="pt-28 pb-4 md:pt-32 md:pb-4 px-4 md:px-16 max-w-7xl mx-auto">
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-brand-gold-ink mb-6 font-display uppercase tracking-tight">
      Speisekarte
    </h1>
    <p class="text-lg md:text-xl text-text-secondary max-w-[75ch] leading-relaxed">
      Jedes Gericht wird frisch und von Hand zubereitet — mit den Aromen Brasiliens und der Wärme Afrikas.
      Angela kocht alles selbst, mit Liebe und den besten Zutaten.
    </p>

    <!-- Quick category navigation -->
    <nav class="flex flex-wrap gap-2.5 mt-8 mb-4" aria-label="Menü-Kategorien">
      {sortedCategories.map(([slug]) => {
        const config = categoryConfig[slug];
        if (!config) return null;
        return (
          <a
            href={`#category-${slug}`}
            class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-bold uppercase tracking-wider rounded-lg
                   bg-surface-card border border-border-subtle text-text-secondary
                   hover:bg-surface-elevated hover:border-brand-gold hover:text-brand-gold-ink
                   active:bg-surface-primary
                   focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold
                   no-underline transition-all duration-[var(--duration-fast)] ease-[var(--ease-spring)]"
          >
            <CategoryIcon name={config.icon} class="w-4 h-4 text-brand-gold-ink" />
            {config.label}
          </a>
        );
      })}
    </nav>

    {/* Top Allergen Legend matching bistro menu reference */}
    <AllergenHeaderLegend />
  </section>

  <!-- ═══ MENU CATEGORIES ═══ -->
  {sortedCategories.map(([slug, items]) => {
    const config = categoryConfig[slug] ?? { label: slug, order: 99, icon: 'mains' };

    // Bebidas: sub-categories (Águas Frescas, Cocktails, Softdrinks, Cafés) with MenuBistroCard
    if (slug === 'drinks') {
      const subCategoryOrder = ['aguas-frescas', 'cocktails', 'softdrinks', 'cafes'];
      const subGrouped = subCategoryOrder
        .map((subSlug) => {
          const subItems = items.filter(
            (item) => item.data.subCategory === subSlug || (!item.data.subCategory && subSlug === 'softdrinks')
          );
          return { subSlug, subItems };
        })
        .filter(({ subItems }) => subItems.length > 0);

      return (
        <section
          id={`category-${slug}`}
          class="pt-2 pb-8 md:pt-4 md:pb-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20 space-y-10"
        >
          <CategoryBanner label={config.label} />

          {/* Sub-categories loop */}
          <div class="space-y-10">
            {subGrouped.map(({ subSlug, subItems }) => {
              const subMeta = drinkSubLabels[subSlug] ?? { label: subSlug, icon: '🍹' };
              return (
                <div class="space-y-4">
                  {/* Sub-category header */}
                  <div class="flex items-center gap-2.5 pb-2 border-b-2 border-[var(--color-menu-gold)]/30">
                    <span class="text-xl" aria-hidden="true">{subMeta.icon}</span>
                    <h3 class="text-lg md:text-xl font-serif font-extrabold text-[var(--color-menu-ink)] uppercase tracking-wider">
                      {subMeta.label}
                    </h3>
                  </div>

                  {/* Sub-category grid: 2 cards per row using MenuBistroCard */}
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
                    {subItems.map((item) => (
                      <MenuBistroCard
                        name={item.data.title}
                        description={item.data.description}
                        descriptionEn={item.data.descriptionEn}
                        priceInCents={item.data.price}
                        priceDisplay={item.data.priceDisplay}
                        priceVariants={item.data.priceVariants}
                        prepTime={item.data.prepTime}
                        prepTimeEn={item.data.prepTimeEn}
                        allergens={item.data.allergens}
                        addOns={item.data.addOns}
                        imageSrc={item.data.image || undefined}
                        imageAlt={item.data.title}
                        available={item.data.available}
                      />
                    ))}
                  </div>
                </div>
              );
            })}
          </div>

          {/* Section-Specific Allergen Legend */}
          <div class="mt-6">
            <AllergenHeaderLegend allergens={items.flatMap((i) => i.data.allergens || [])} />
          </div>
        </section>
      );
    }

    // Bistro-paper categories: banner + optional 3-photo showcase + card grid + allergen legend.
    // Shared by Vorspeisen, Quesadillas, Tacos, Bowls, Pratos Feitos, Pratos Do Mar, Sobremesas —
    // previously ~500 lines of near-identical JSX repeated per category.
    if (bistroCategorySlugs.has(slug)) {
      return (
        <section
          id={`category-${slug}`}
          class="pt-2 pb-8 md:pt-4 md:pb-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20"
        >
          <CategoryBanner label={config.label} subtitle={config.subtitle} />

          {config.showcaseImages && <CategoryShowcase images={config.showcaseImages} />}

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
            {items.map((item) => (
              <MenuBistroCard
                name={item.data.title}
                description={item.data.description}
                descriptionEn={item.data.descriptionEn}
                priceInCents={item.data.price}
                prepTime={item.data.prepTime}
                prepTimeEn={item.data.prepTimeEn}
                allergens={item.data.allergens}
                addOns={item.data.addOns}
                imageSrc={item.data.image || undefined}
                imageAlt={item.data.title}
                available={item.data.available}
              />
            ))}
          </div>

          {/* Section-Specific Allergen Legend */}
          <div class="mt-6">
            <AllergenHeaderLegend allergens={items.flatMap((i) => i.data.allergens || [])} />
          </div>
        </section>
      );
    }

    // Fallback for any category outside the bistro-paper set (e.g. Beilagen/Sides):
    // generic icon header + MenuItemCard grid, which also surfaces dietary badges
    // that MenuBistroCard does not render.
    return (
      <section
        id={`category-${slug}`}
        class="py-8 md:py-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20"
      >
        {/* Category heading */}
        <div class="flex items-center gap-3.5 mb-8">
          <div class="w-10 h-10 rounded-xl bg-brand-gold/15 text-brand-gold-ink flex items-center justify-center">
            <CategoryIcon name={config.icon} class="w-6 h-6" />
          </div>
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-text-primary font-display uppercase tracking-wider">
            {config.label}
          </h2>
          <div class="flex-1 h-0.5 bg-border-subtle ml-2"></div>
        </div>

        {/* Menu items grid */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
          {items.map((item) => (
            <MenuItemCard
              name={item.data.title}
              description={item.data.description}
              priceInCents={item.data.price}
              priceVariants={item.data.priceVariants}
              dietary={item.data.dietary as DietaryTag[] | undefined}
              allergens={item.data.allergens}
              prepTime={item.data.prepTime}
              addOns={item.data.addOns}
              available={item.data.available}
              featured={item.data.featured}
              imageSrc={item.data.image || undefined}
              imageAlt={item.data.title}
              imageWidth={400}
              imageHeight={300}
            />
          ))}
        </div>

        {/* Section-Specific Allergen Legend */}
        <div class="mt-6">
          <AllergenHeaderLegend allergens={items.flatMap((i) => i.data.allergens || [])} />
        </div>
      </section>
    );
  })}

  <!-- ═══ EMPTY STATE ═══ -->
  {sortedCategories.length === 0 && (
    <section class="py-16 px-4 md:px-16 max-w-7xl mx-auto text-center" aria-label="Leere Speisekarte">
      <p class="text-text-tertiary text-lg py-20">
        Die Speisekarte wird gerade aktualisiert. Bitte schauen Sie später vorbei!
      </p>
    </section>
  )}

  <Footer slot="footer" />
</Base>
