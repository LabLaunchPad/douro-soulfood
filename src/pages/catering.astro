---
export const prerender = true;

import Base from '@/layouts/Base.astro';
import NavBar from '@/components/layout/NavBar.astro';
import Footer from '@/components/layout/Footer.astro';
import FeatureCard from '@/components/sections/FeatureCard.astro';
import FaqAccordion from '@/components/sections/FaqAccordion.astro';
import cateringEvent from '@/assets/catering/event.webp';
import cateringPrivate from '@/assets/catering/private.webp';
import { absoluteUrl } from '@/lib/site';
import { faqNode } from '@/lib/seo/graph';

/** Catering FAQ: inline (page-specific, not the global Keystatic collection
 * shown on the homepage). Same items feed the visible accordion and the
 * FAQPage JSON-LD node, so prose and schema cannot drift apart. */
const cateringFaq = [
  {
    question: 'Was kostet ein Catering von D’ouro in Salzburg?',
    answer:
      'Das hängt von Personenzahl, Menü und Umfang ab. Schicken Sie uns Anlass, Datum und Gästezahl über die Kontaktseite oder rufen Sie an: Sie erhalten ein individuelles Angebot. Pauschalpreise nennen wir bewusst nicht, weil jedes Event anders isst.',
  },
  {
    question: 'Für welche Anlässe bietet D’ouro Catering an?',
    answer:
      'Firmenfeiern und Team-Essen ebenso wie private Feiern: Geburtstage, Hochzeiten und Familientreffen. Wir liefern brasilianische und afrikanische Gerichte, von Tacos und Bowls bis Feijoada, direkt zu Ihrer Veranstaltung in Salzburg.',
  },
  {
    question: 'Wie weit im Voraus muss ich anfragen?',
    answer:
      'Je früher, desto besser, besonders für Hochzeiten und Firmenfeiern in der Hauptsaison. Aber fragen Sie auch kurzfristig an: Rufen Sie uns an unter +43 676 4231921, dann wissen Sie sofort, was möglich ist.',
  },
  {
    question: 'Liefern Sie das Catering oder muss ich es abholen?',
    answer:
      'Wir bringen das Essen direkt zu Ihrer Location in Salzburg. Ob Servicepersonal vor Ort möglich ist, klären wir bei Ihrer Anfrage mit.',
  },
  {
    question: 'Gibt es vegane und vegetarische Optionen fürs Catering?',
    answer:
      'Ja. Wir haben vegane und vegetarische Gerichte, von Bowls über Eintöpfe bis zu Beilagen. Sagen Sie uns bei der Anfrage Bescheid, dann stellen wir das Menü entsprechend zusammen.',
  },
  {
    question: 'Woher kommen die Rezepte fürs Catering?',
    answer:
      'Gründerin Angela kocht brasilianische Gerichte wie Feijoada und Coxinha, ergänzt um westafrikanische Eintöpfe wie Egusi-Suppe mit Fufu. Alle Catering-Menüs kommen aus unserer Küche in der Auerspergstraße 10 in Salzburg.',
  },
];
---

<Base
  title="Catering & Events in Salzburg"
  description="Catering von D'ouro Soulfood in Salzburg: Firmenfeiern, Team-Essen, Hochzeiten, Geburtstage und Familientreffen mit brasilianischem und afrikanischem Soulfood, direkt zu Ihrem Event."
  breadcrumb={[{ name: 'Catering & Events', path: '/catering/' }]}
  extraSchemaNodes={[faqNode(cateringFaq, absoluteUrl('/catering/', Astro.site))]}
>
  <NavBar slot="nav" />

  <section class="pt-28 md:pt-32 pb-16 md:pb-24 px-4 md:px-16 max-w-7xl mx-auto">
    <h1 class="text-[clamp(2rem,4vw,3rem)] font-bold text-brand-gold-ink mb-4 font-display break-words">
      Catering & Events
    </h1>
    <p class="text-text-secondary max-w-[52ch] leading-relaxed mb-12">
      Bringen Sie den Geschmack von D'ouro zu Ihrem nächsten Event. Von Firmenfeiern bis privaten
      Feiern: Wir liefern Soulfood direkt zu Ihnen.
    </p>
  </section>

  <FeatureCard
    title="Firmenevents"
    description="Catering-Pakete für Team-Essen und Firmenfeiern. Sie wählen Menü und Umfang."
    image={{
      src: cateringEvent,
      alt: 'Firmenevent Catering',
      width: 800,
      height: 600,
    }}
    cta={{ label: 'Anfrage senden', href: '/contact' }}
  />

  <FeatureCard
    title="Private Feiern"
    description="Für private Feiern bringen wir das Essen zu Ihnen."
    image={{
      src: cateringPrivate,
      alt: 'Private Feiern Catering',
      width: 800,
      height: 600,
    }}
    cta={{ label: 'Anfrage senden', href: '/contact' }}
    reverse
  />

  <FaqAccordion
    ariaLabel="Häufige Fragen zum Catering"
    eyebrow="Catering-FAQ"
    title="Häufige Fragen zum Catering"
    items={cateringFaq}
  />

  <Footer slot="footer" />
</Base>
