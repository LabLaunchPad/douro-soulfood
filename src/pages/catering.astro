---
export const prerender = true;

import Base from '@/layouts/Base.astro';
import NavBar from '@/components/layout/NavBar.astro';
import Footer from '@/components/layout/Footer.astro';
import FeatureCard from '@/components/sections/FeatureCard.astro';
import cateringEvent from '@/assets/catering/event.webp';
import cateringPrivate from '@/assets/catering/private.webp';
---

<Base
  title="Catering & Events"
  description="Catering von D'ouro Soulfood in Salzburg: von Team-Lunchs und Firmenfeiern bis zu Geburtstagen, Hochzeiten und Familientreffen, brasilianisches und afrikanisches Soulfood direkt zu Ihrem Event."
  breadcrumb={[{ name: 'Catering & Events', path: '/catering/' }]}
>
  <NavBar slot="nav" />

  <section class="pt-28 md:pt-32 pb-16 md:pb-24 px-4 md:px-16 max-w-7xl mx-auto">
    <h1 class="text-[clamp(2rem,4vw,3rem)] font-bold text-brand-gold-ink mb-4 font-display break-words">
      Catering & Events
    </h1>
    <p class="text-text-secondary max-w-[52ch] leading-relaxed mb-12">
      Bringen Sie den Geschmack von D'ouro zu Ihrem nächsten Event. Von Firmenfeiern bis privaten
      Feiern: Wir liefern Soulfood direkt zu Ihnen.
    </p>
  </section>

  <FeatureCard
    title="Firmenevents"
    description="Von Team-Lunchs bis Firmenfeiern passen sich unsere Catering-Pakete Ihren Bedürfnissen an."
    image={{
      src: cateringEvent,
      alt: 'Firmenevent Catering',
      width: 800,
      height: 600,
    }}
    cta={{ label: 'Anfrage senden', href: '/contact' }}
  />

  <FeatureCard
    title="Private Feiern"
    description="Geburtstage, Hochzeiten, Familientreffen. Wir bringen Soulfood direkt zu Ihnen."
    image={{
      src: cateringPrivate,
      alt: 'Private Feiern Catering',
      width: 800,
      height: 600,
    }}
    cta={{ label: 'Anfrage senden', href: '/contact' }}
    reverse
  />

  <Footer slot="footer" />
</Base>
