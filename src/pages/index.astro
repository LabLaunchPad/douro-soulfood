---
export const prerender = true;

import Base from '@/layouts/Base.astro';
import NavBar from '@/components/NavBar.astro';
import HeroSection from '@/components/HeroSection.astro';
import ReviewBadge from '@/components/ReviewBadge.astro';
import MenuItemCard from '@/components/MenuItemCard.astro';
import CategoryIcon from '@/components/CategoryIcon.astro';
import OurStory from '@/components/OurStory.astro';
import Footer from '@/components/Footer.astro';
import { getCollection } from 'astro:content';

/**
 * HOME PAGE — D'ouro Soulfood Bistro
 */

type DietaryTag = 'vegan' | 'vegetarian' | 'gluten-free' | 'spicy' | 'halal' | 'dairy-free';

/** 6 Core Category Slots for Homepage */
const categorySlots = [
  { slug: 'appetizers', title: 'Vorspeisen / Entradas', desc: 'Coxinha, Pão de Queijo & Ceviche', icon: 'appetizers' },
  { slug: 'quesadillas', title: 'Quesadillas', desc: 'Melted Gouda & Mozzarella-Mix', icon: 'quesadillas' },
  { slug: 'tacos', title: 'Tacos', desc: 'Picanha, Pollo, Vegano & Gambas', icon: 'tacos' },
  { slug: 'bowls', title: 'Bowls', desc: 'Brazil Beef, Chipotle & Surf & Turf', icon: 'bowls' },
  { slug: 'mains', title: 'Pratos Feitos', desc: 'Feijoada & African Peanut Stew mit Fufu', icon: 'mains' },
  { slug: 'drinks', title: 'Bebidas & Sobremesas', desc: 'Caipirinha, Guaraná & Brigadeiros', icon: 'drinks' },
];

/** Fetch featured menu items for the homepage (bestsellers) */
const featuredItems = (await getCollection('menu_items'))
  .filter((item) => item.data.featured && item.data.available !== false)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 6);

/** FAQ entries from KeystaticCMS */
const faqEntries = (await getCollection('faq'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const faqItems = faqEntries.map((item) => ({
  question: item.data.question,
  answer: item.data.answer,
}));

// SEO CONFIG
const SITE_URL = 'https://douro-soulfood.com';
const PAGE_TITLE = "Afro-Latin Cuisine in Salzburg";
const PAGE_DESCRIPTION =
  "Fresh Brazilian & African soulfood by Angela in Salzburg. Tacos, bowls, African stews. Mon–Sat 11–20h. Auerspergstraße 10.";
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  canonical={SITE_URL}
>
  {/* 1. NAVBAR */}
  <NavBar slot="nav" />

  {/* 2. HERO */}
  <HeroSection
    accent="D'ouro Soulfood Bistro"
    headline="Afro-Latin Soul in the Heart of Salzburg"
    subheadline="Fresh, handmade Brazilian & African cuisine by Angela"
    images={[
      {
        src: 'https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1600&q=80',
        alt: "D'ouro Soulfood Bistro — Afro-Latin cuisine in Salzburg",
        width: 1600,
        height: 900,
      },
    ]}
    ctaPrimary={{ label: 'Visit Us Today', href: '/contact' }}
    ctaSecondary={{ label: 'See Our Menu', href: '/menu' }}
  />

  {/* 3. REVIEW BADGE */}
  <section class="py-6 md:py-8 px-4 md:px-16 border-b border-border-subtle" aria-label="Bewertungen">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-center gap-4">
      <ReviewBadge
        rating={4.8}
        reviewCount={978}
        source="Google Reviews"
        href="https://www.tripadvisor.com/Restaurant_Review-g190441-d25104877-Reviews-D_ouro_Soulfood_Bistro-Salzburg_Austrian_Alps.html"
        size="lg"
      />
      <span class="text-text-tertiary text-sm">TripAdvisor Certificate of Excellence</span>
    </div>
  </section>

  {/* 4. FEATURED MENU & 6 CATEGORY SLOTS */}
  <section class="pt-8 md:pt-10 pb-12 md:pb-16 px-4 md:px-16 max-w-7xl mx-auto" aria-label="Speisekarte Highlights">
    {/* ── 6 CORE CATEGORY SLOTS GRID ── */}
    <div class="mb-14">
      <div class="text-center mb-8">
        <span class="inline-block text-sm font-semibold text-brand-gold uppercase tracking-wider mb-2">
          Unsere Speisekarte
        </span>
        <h2 class="text-2xl md:text-4xl font-extrabold text-text-primary font-display uppercase tracking-tight">
          Entdecken Sie unsere 6 Afro-Latino Spezialitäten
        </h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 md:gap-4">
        {categorySlots.map((slot) => (
          <a
            href={`/menu#category-${slot.slug}`}
            class="group flex flex-col items-center text-center p-4 rounded-2xl bg-surface-card border border-border-subtle hover:border-brand-gold/50 hover:bg-surface-elevated transition-all duration-[var(--duration-fast)] no-underline shadow-md"
          >
            <div class="w-12 h-12 rounded-xl bg-brand-gold/15 text-brand-gold flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
              <CategoryIcon name={slot.icon} class="w-6 h-6" />
            </div>
            <h3 class="text-sm font-bold text-text-primary group-hover:text-brand-gold font-display transition-colors mb-1">
              {slot.title}
            </h3>
            <p class="text-[11px] text-text-tertiary leading-tight line-clamp-2">
              {slot.desc}
            </p>
          </a>
        ))}
      </div>
    </div>

    {/* ── BESTSELLERS SECTION ── */}
    <div class="text-center mb-10">
      <span class="inline-block text-sm font-semibold text-brand-gold uppercase tracking-wider mb-2">
        Empfehlungen
      </span>
      <h2 class="text-2xl md:text-4xl font-semibold text-text-primary font-display">
        Beliebte Gerichte im D'ouro Bistro
      </h2>
      <p class="text-text-secondary mt-2 max-w-[75ch] mx-auto text-sm md:text-base">
        Frisch von Angela zubereitet — mit den besten Zutaten Brasiliens und Westafrikas.
      </p>
    </div>

    {/* Featured items grid — 3 columns on desktop */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
      {featuredItems.map((item) => (
        <MenuItemCard
          name={item.data.title}
          description={item.data.description}
          priceInCents={item.data.price}
          dietary={item.data.dietary as DietaryTag[] | undefined}
          allergens={item.data.allergens}
          prepTime={item.data.prepTime}
          addOns={item.data.addOns}
          available={item.data.available}
          featured={item.data.featured}
          imageSrc={item.data.image || undefined}
          imageAlt={item.data.title}
          imageWidth={400}
          imageHeight={300}
        />
      ))}
    </div>

    {/* CTA: See Full Menu */}
    <div class="mt-10 md:mt-14 text-center">
      <a
        href="/menu"
        class="group inline-flex items-center gap-2 rounded-sm
               bg-brand-gold hover:bg-brand-gold-light active:bg-brand-gold-dark
               min-h-12 px-6 py-3 text-base font-semibold text-brand-espresso
               focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold
               no-underline transition-colors duration-[var(--duration-fast)] ease-[var(--ease-spring)] shadow-glow-gold"
      >
        Komplette Speisekarte ansehen
        <svg
          class="w-4 h-4 opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-[var(--duration-fast)] ease-[var(--ease-spring)]"
          viewBox="0 0 256 256"
          fill="none"
          stroke="currentColor"
          stroke-width="24"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="70" y1="128" x2="216" y2="128" />
          <polyline points="144 56 216 128 144 200" />
        </svg>
      </a>
    </div>
  </section>

  {/* 5. OUR STORY */}
  <OurStory
    faqTitle="Häufig gestellte Fragen"
    faqItems={faqItems}
    location={{
      title: 'Salzburg, Österreich',
      subtitle: 'Restaurant',
      address: ['Auerspergstraße 10', '5020 Salzburg'],
      phone: '+43 676 4231921',
      phoneHref: 'tel:+436764231921',
      directionsHref:
        'https://www.google.com/maps/search/?api=1&query=Auerspergstra%C3%9Fe+10%2C+5020+Salzburg%2C+Austria',
      hoursToday: '11:00 – 20:00',
      orderHref: '/menu',
      orderLabel: 'Jetzt bestellen',
    }}
  >
    {/* Angela's story */}
    <section class="pt-8 md:pt-10 pb-12 md:pb-16 px-4 md:px-16 max-w-7xl mx-auto" aria-label="Our Story">
      <div class="glass-gold rounded-2xl p-8 md:p-12 max-w-3xl mx-auto text-center">
        <span class="inline-block text-sm font-semibold text-brand-gold uppercase tracking-wider mb-4">
          Our Story
        </span>
        <h2 class="text-2xl md:text-4xl font-semibold text-text-primary font-display mb-6">
          How D'ouro Began
        </h2>
        <p class="text-base md:text-lg text-text-secondary leading-relaxed max-w-[75ch] mx-auto">
          D'ouro started during lockdown when Angela handed out homemade Brazilian food
          to anyone who wanted it from her house. That same warmth lives in every dish today.
        </p>
        <div class="mt-8 flex items-center justify-center gap-3">
          <div class="w-12 h-12 rounded-full bg-brand-gold/20 flex items-center justify-center" aria-hidden="true">
            <svg
              class="w-6 h-6 text-brand-gold"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
          </div>
          <div class="text-left">
            <p class="text-sm font-semibold text-text-primary">Angela</p>
            <p class="text-xs text-text-tertiary">Founder & Chef</p>
          </div>
        </div>
      </div>
    </section>
  </OurStory>

  {/* 6. FOOTER */}
  <Footer
    slot="footer"
    links={[
      { label: 'Speisekarte', href: '/menu' },
      { label: 'Catering & Events', href: '/catering' },
      { label: 'Über uns', href: '/about' },
      { label: 'Kontakt', href: '/contact' },
      { label: 'Geschenkkarten', href: '/gift-cards' },
    ]}
    legalLinks={[
      { label: 'Impressum', href: '/impressum' },
      { label: 'Datenschutz', href: '/datenschutz' },
    ]}
  />
</Base>
